<UserControl
    x:Class="Scadix.Designer.DocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:DesignerControls="clr-namespace:Scadix.AxamlDesigner.Controls;assembly=Scadix.AxamlDesigner"
    xmlns:local="clr-namespace:Scadix.Designer"
    x:DataType="local:Document">

    <DockPanel>

        <!-- Mode switcher (Design / XAML) — hidden for non-XAML files -->
        <DesignerControls:EnumBar
            Value="{Binding Mode}"
            DockPanel.Dock="Bottom"
            IsVisible="{Binding IsXamlFile, Converter={StaticResource CollapsedWhenFalse}}" />

        <Grid x:Name="EditorLayout" ColumnDefinitions="*,0,0">

            <!-- ── XAML Editor (XamlEditorView replaces raw TextEditor) ── -->
            <local:XamlEditorView
                x:Name="uxXamlEditor"
                IsVisible="{Binding IsEditorVisible,
                            Converter={StaticResource CollapsedWhenFalse}}">

                <local:XamlEditorView.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="Copy"
                                  InputGesture="Ctrl+C"
                                  Command="{Binding CopyMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="Cut"
                                  InputGesture="Ctrl+X"
                                  Command="{Binding CutMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="Paste"
                                  InputGesture="Ctrl+V"
                                  Command="{Binding PasteMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="-"/>
                        <MenuItem Header="Select All"
                                  InputGesture="Ctrl+A"
                                  Command="{Binding SelectAllMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                    </MenuFlyout>
                </local:XamlEditorView.ContextFlyout>

            </local:XamlEditorView>

            <!-- ── Design surface ── -->
            <GridSplitter x:Name="SplitDivider" Grid.Column="1"
                          Background="{DynamicResource ThemeControlMidBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding IsSplitMode}" />
            <DockPanel Grid.Column="2" IsVisible="{Binding IsPreviewVisible}">
                <TextBlock DockPanel.Dock="Top" Text="Preview - Click a control to inspect it"
                           IsVisible="{Binding IsSplitMode}" Margin="8,4" />
                <StackPanel x:Name="SplitGroupCommandBar" DockPanel.Dock="Top"
                            Orientation="Horizontal" IsVisible="False" Spacing="2" Margin="8,0,8,4">
                    <Button x:Name="AlignLeftButton" ToolTip.Tip="Align left" Click="AlignLeft_Click" Content="L" />
                    <Button x:Name="AlignHorizontalCenterButton" ToolTip.Tip="Align horizontal centers" Click="AlignHorizontalCenter_Click" Content="HC" />
                    <Button x:Name="AlignRightButton" ToolTip.Tip="Align right" Click="AlignRight_Click" Content="R" />
                    <Button x:Name="AlignTopButton" ToolTip.Tip="Align top" Click="AlignTop_Click" Content="T" />
                    <Button x:Name="AlignVerticalCenterButton" ToolTip.Tip="Align vertical centers" Click="AlignVerticalCenter_Click" Content="VC" />
                    <Button x:Name="AlignBottomButton" ToolTip.Tip="Align bottom" Click="AlignBottom_Click" Content="B" />
                    <Button x:Name="DistributeHorizontalButton" ToolTip.Tip="Distribute horizontally" Click="DistributeHorizontal_Click" Content="H↔" />
                    <Button x:Name="DistributeVerticalButton" ToolTip.Tip="Distribute vertically" Click="DistributeVertical_Click" Content="V↕" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewError}" TextWrapping="Wrap"
                           IsVisible="{Binding HasPreviewError}" Margin="8" Foreground="DarkOrange" />
<Grid>
                  <ContentPresenter Content="{Binding DesignSurface}"
                                    IsHitTestVisible="{Binding IsDesignerInteractive}"
                                    IsEnabled="{Binding IsDesignerInteractive}" />
                  <Border x:Name="PreviewSelectionOverlay" Background="Transparent"
                          IsVisible="{Binding IsSplitMode}" PointerPressed="PreviewPointerPressed" />
                  <Canvas x:Name="SplitResizeOverlay" Focusable="True"
                          IsVisible="{Binding IsSplitMode}"
                          IsHitTestVisible="True" />
                  <Canvas x:Name="AlignmentGuidesOverlay" IsVisible="{Binding IsSplitMode}"
                          IsHitTestVisible="False" />
                  <Canvas IsVisible="{Binding IsSplitMode}" IsHitTestVisible="False">
                      <Border x:Name="SnapReadout" IsVisible="False"
                              Background="#CC000000" CornerRadius="4" Padding="6,2"
                              IsHitTestVisible="False">
                          <TextBlock x:Name="SnapReadoutText" Foreground="White" FontSize="11" FontFamily="Consolas,Monospace" />
                      </Border>
                  </Canvas>
                </Grid>
            </DockPanel>

        </Grid>

    </DockPanel>
</UserControl>
