<UserControl
    x:Class="Scadix.Designer.DocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:DesignerControls="clr-namespace:Scadix.AxamlDesigner.Controls;assembly=Scadix.AxamlDesigner"
    xmlns:local="clr-namespace:Scadix.Designer"
    x:DataType="local:Document">

    <DockPanel>

        <!-- Mode switcher (Design / XAML) — hidden for non-XAML files -->
        <DesignerControls:EnumBar
            Value="{Binding Mode}"
            DockPanel.Dock="Bottom"
            IsVisible="{Binding IsXamlFile, Converter={StaticResource CollapsedWhenFalse}}" />

        <Grid x:Name="EditorLayout" ColumnDefinitions="*,0,0">

            <!-- ── XAML Editor (XamlEditorView replaces raw TextEditor) ── -->
            <local:XamlEditorView
                x:Name="uxXamlEditor"
                IsVisible="{Binding IsEditorVisible,
                            Converter={StaticResource CollapsedWhenFalse}}">

                <local:XamlEditorView.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="Copy"
                                  InputGesture="Ctrl+C"
                                  Command="{Binding CopyMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="Cut"
                                  InputGesture="Ctrl+X"
                                  Command="{Binding CutMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="Paste"
                                  InputGesture="Ctrl+V"
                                  Command="{Binding PasteMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                        <MenuItem Header="-"/>
                        <MenuItem Header="Select All"
                                  InputGesture="Ctrl+A"
                                  Command="{Binding SelectAllMouseCommand}"
                                  CommandParameter="{Binding #uxXamlEditor.TextArea}" />
                    </MenuFlyout>
                </local:XamlEditorView.ContextFlyout>

            </local:XamlEditorView>

            <!-- ── Design surface ── -->
            <GridSplitter x:Name="SplitDivider" Grid.Column="1"
                          Background="{DynamicResource ThemeControlMidBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding IsSplitMode}" />
            <DockPanel Grid.Column="2" IsVisible="{Binding IsPreviewVisible}">
                <TextBlock DockPanel.Dock="Top" Text="Preview - Click a control to inspect it"
                           IsVisible="{Binding IsSplitMode}" Margin="8,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewError}" TextWrapping="Wrap"
                           IsVisible="{Binding HasPreviewError}" Margin="8" Foreground="DarkOrange" />
                <Grid>
                  <ContentPresenter Content="{Binding DesignSurface}"
                                  IsHitTestVisible="{Binding IsDesignerInteractive}"
                                  IsEnabled="{Binding IsDesignerInteractive}" />
                  <Border x:Name="PreviewSelectionOverlay" Background="Transparent"
                          IsVisible="{Binding IsSplitMode}" PointerPressed="PreviewPointerPressed" />
                  <Canvas x:Name="SplitResizeOverlay"
                          IsVisible="{Binding IsSplitMode}"
                          IsHitTestVisible="True" />
                </Grid>
            </DockPanel>

        </Grid>

    </DockPanel>
</UserControl>
