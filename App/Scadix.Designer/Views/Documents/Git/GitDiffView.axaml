<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:local="using:Scadix.Designer"
             x:Class="Scadix.Designer.Views.Documents.GitDiffView"
             x:DataType="vm:GitDiffDocumentViewModel"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ══ Row 0: Top toolbar (↑↓ changes Stage All Undo All) ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeControlLowBrush}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <!-- Left: navigation + stats -->
                <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Left">
                    <!-- Prev change -->
                    <Button Background="Transparent" BorderThickness="0" Padding="5"
                            ToolTip.Tip="Previous Change">
                        <Path Data="M7,15L12,10L17,15H7Z"
                              Fill="{DynamicResource ThemeForegroundLowBrush}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <!-- Next change -->
                    <Button Background="Transparent" BorderThickness="0" Padding="5"
                            ToolTip.Tip="Next Change">
                        <Path Data="M7,10L12,15L17,10H7Z"
                              Fill="{DynamicResource ThemeForegroundLowBrush}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="16"
                               Fill="{DynamicResource ThemeBorderLowBrush}" Margin="2,0"/>

                    <!-- Changes count -->
                    <TextBlock Text="{Binding ChangesCount, StringFormat='{}{0} changes'}"
                               FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Removed count -->
                    <Border Background="#3C1F1F" CornerRadius="3" Padding="6,2"
                            IsVisible="{Binding RemovedCount}">
                        <TextBlock Text="{Binding RemovedCount, StringFormat='-{0}'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#E06C75"/>
                    </Border>

                    <!-- Added count -->
                    <Border Background="#1F3C1F" CornerRadius="3" Padding="6,2"
                            IsVisible="{Binding AddedCount}">
                        <TextBlock Text="{Binding AddedCount, StringFormat='+{0}'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5DA656"/>
                    </Border>

                    <Rectangle Width="1" Height="16"
                               Fill="{DynamicResource ThemeBorderLowBrush}" Margin="2,0"/>

                    <!-- Stage All -->
                    <Button Background="Transparent" BorderThickness="0" Padding="5,3"
                            ToolTip.Tip="Stage All">
                        <TextBlock Text="Stage All" FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                    </Button>

                    <!-- Undo All -->
                    <Button Background="Transparent" BorderThickness="0" Padding="5,3"
                            ToolTip.Tip="Undo All Changes">
                        <TextBlock Text="Undo All" FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Right: Show Staging Controls + Summary -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Background="Transparent" BorderThickness="0" Padding="5,3"
                            ToolTip.Tip="Show Staging Controls">
                        <TextBlock Text="Show Staging Controls" FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                    </Button>
                    <Rectangle Width="1" Height="16"
                               Fill="{DynamicResource ThemeBorderLowBrush}" Margin="2,0"/>
                    <Button Background="Transparent" BorderThickness="0" Padding="5,3"
                            ToolTip.Tip="Summary">
                        <TextBlock Text="Summary" FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Row 1: Column headers ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,1,*">
            <!-- Left header -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThemeControlLowBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding LeftLabel}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorderLowBrush}"/>
            <!-- Right header -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ThemeControlLowBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding RightLabel}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Row 2: Side-by-side editors ══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,1,*">

            <!-- Loading overlay -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    IsVisible="{Binding IsLoading}" ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="Loading diff..." FontSize="12"
                               Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Left: Index (staged) — AvaloniaEdit read-only -->
           <local:XamlEditorView x:Name="LeftEditor" Grid.Column="0"/>

            <!-- Splitter -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorderLowBrush}"/>

            <!-- Right: Working tree — AvaloniaEdit read-only -->
            <local:XamlEditorView x:Name="RightEditor" Grid.Column="2"/>
        </Grid>
    </Grid>
</UserControl>
