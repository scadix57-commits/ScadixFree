<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels"
             xmlns:local="clr-namespace:Scadix.Designer"
             x:Class="Scadix.Designer.Views.Documents.CommitDetailsView"
             x:DataType="vm:GitRepositoriesViewModel">

    <UserControl.Resources>
        <local:AuthorColorConverter   x:Key="AuthorColorConverter"/>
        <local:AuthorInitialConverter x:Key="AuthorInitialConverter"/>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="1"
            Background="{DynamicResource ThemeBackgroundBrush}">
        <Grid ColumnDefinitions="*,4,300">

        <!-- ══ LEFT: Diff editors ══ -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <!-- ── Toolbar ── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeControlLowBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="6,4">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" DockPanel.Dock="Left">
                        <Button x:Name="BtnPrevChange" Background="Transparent" BorderThickness="0" Padding="5"
                                ToolTip.Tip="Previous Change">
                            <Path Data="M7,15L12,10L17,15H7Z"
                                  Fill="{DynamicResource ThemeForegroundLowBrush}"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnNextChange" Background="Transparent" BorderThickness="0" Padding="5"
                                ToolTip.Tip="Next Change">
                            <Path Data="M7,10L12,15L17,10H7Z"
                                  Fill="{DynamicResource ThemeForegroundLowBrush}"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Rectangle Width="1" Height="14"
                                   Fill="{DynamicResource ThemeBorderLowBrush}" Margin="3,0"/>
                        <TextBlock x:Name="ChangesCountLabel"
                                   Text="{Binding SelectedCommitFiles.Count, StringFormat='{}{0} change(s)'}"
                                   FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   VerticalAlignment="Center" Margin="4,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Background="Transparent" BorderThickness="0" Padding="5,3">
                            <TextBlock Text="Summary" FontSize="11"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── File headers ── -->
            <Grid Grid.Row="1" ColumnDefinitions="*,1,*">
                <Border Grid.Column="0"
                        Background="{DynamicResource ThemeControlLowBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock x:Name="LeftFileLabel"
                               Text="Select a file" FontSize="11"
                               Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorderLowBrush}"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource ThemeControlLowBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="0,0,0,1" Padding="6,3">
                    <TextBlock x:Name="RightFileLabel"
                               Text="" FontSize="11"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <!-- ── Side-by-side editors ── -->
            <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                <!-- Left: previous version (parent commit) -->
               <local:XamlEditorView x:Name="LeftEditor" Grid.Column="0"/>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorderLowBrush}"/>
                <!-- Right: this commit version -->
                 <local:XamlEditorView x:Name="RightEditor" Grid.Column="2"/>
            </Grid>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeBorderLowBrush}"/>

        <!-- ══ RIGHT: Commit info + Changes tree ══ -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">

            <!-- ── Commit ID + actions ── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeControlLowBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding SelectedCommit.ShortHash, StringFormat='ID: {0}'}"
                               FontSize="11" FontFamily="Consolas"
                               Foreground="#0078D4" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Content="Revert" Height="22" Padding="8,0" FontSize="11"
                                Background="Transparent" BorderThickness="1"
                                Command="{Binding RevertCommitAsync}"
                                CommandParameter="{Binding SelectedCommit}"/>
                        <Button Height="22" Padding="8,0" FontSize="11"
                                Background="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="Reset" FontSize="11"/>
                                <Path Data="M7,10L12,15L17,10H7Z"
                                      Fill="{DynamicResource ThemeForegroundBrush}"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Explain" Height="22" Padding="8,0" FontSize="11"
                                Background="Transparent" BorderThickness="1"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Message ── -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <StackPanel Spacing="3">
                    <TextBlock Text="Message:" FontSize="10" Foreground="Gray"/>
                    <TextBlock Text="{Binding SelectedCommit.Message}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- ── Author + Date ── -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Avatar: real Gravatar with initials fallback -->
                    <Panel Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                        <!-- Fallback colored circle -->
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{Binding SelectedCommit.Author, Converter={StaticResource AuthorColorConverter}}">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding SelectedCommit.Author, Converter={StaticResource AuthorInitialConverter}}"/>
                        </Border>
                        <!-- Real Gravatar on top when loaded -->
                        <Border Width="36" Height="36" CornerRadius="18"
                                ClipToBounds="True"
                                IsVisible="{Binding SelectedCommit.Avatar, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding SelectedCommit.Avatar}" Stretch="UniformToFill"/>
                        </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCommit.Author}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"/>
                        <TextBlock Text="{Binding SelectedCommit.Date, StringFormat='{}{0:d/MM/yyyy HH:mm}'}"
                                   FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Changes tree ── -->
            <Grid Grid.Row="3" RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="{DynamicResource ThemeControlLowBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="Changes ("/>
                            <Run Text="{Binding SelectedCommitFiles.Count}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <Button HorizontalAlignment="Right" Background="Transparent"
                                BorderThickness="0" Padding="4">
                            <Path Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"
                                  Fill="Gray" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <TreeView x:Name="FilesTree"
                              ItemsSource="{Binding CommitFilesTree}"
                              Background="Transparent" BorderThickness="0"
                              SelectionChanged="OnFileSelected"
                              DoubleTapped="OnFileDoubleTapped">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:GitChangeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="MinHeight" Value="24"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}"
                                              x:DataType="vm:GitChangeNode">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                                    <!-- Folder icon -->
                                    <Path Grid.Column="0"
                                          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                          Fill="#E5C07B" Width="14" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,5,0"
                                          IsVisible="{Binding IsFolder}"/>
                                    <!-- File icon -->
                                    <Path Grid.Column="0"
                                          Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"
                                          Fill="{Binding Status, Converter={StaticResource GitStatusForegroundConverter}}"
                                          Width="12" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,5,0"
                                          IsVisible="{Binding !IsFolder}"/>
                                    <!-- Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeForegroundBrush}"
                                               ToolTip.Tip="{Binding FullPath}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- Status badge -->
                                    <Border Grid.Column="2"
                                            Width="22" Height="18" CornerRadius="2"
                                            Margin="4,0,2,0"
                                            Background="{Binding Status, Converter={StaticResource GitStatusBackgroundConverter}}"
                                            IsVisible="{Binding !IsFolder}">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</UserControl>
