<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels"
             x:Class="Scadix.Designer.Views.BranchPopup"
             x:DataType="vm:GitRepositoriesViewModel"
             Width="420" Height="500"
             Background="Transparent">

    <Border Background="{DynamicResource ThemeBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="1" CornerRadius="6"
            BoxShadow="0 8 24 0 #40000000">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Search box -->
            <Border Grid.Row="0" Padding="8,8,8,4">
                <TextBox x:Name="SearchBox"
                         Watermark="Search for branches and actions..."
                         FontSize="12" Height="30"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.InnerLeftContent>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="Gray" Width="14" Height="14" Stretch="Uniform" Margin="6,0,4,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Border>

            <!-- Top actions -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Button x:Name="UpdateBtn" Classes="branch-action" Click="Update_Click">
                        <DockPanel>
                            <Path Data="M20,12V20H4V12H9L12,15L15,12H20M20,10H15L12,13L9,10H4V8H20V10Z"
                                  Fill="#61AFEF" Width="14" Height="14" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="Update Project" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button x:Name="CommitBtn" Classes="branch-action" Click="Commit_Click">
                        <DockPanel>
                            <Path Data="M17,12H12.5L14.5,10L13.08,8.59L9,12.67L13.08,16.75L14.5,15.34L12.5,13.33H17V12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                  Fill="#E5C07B" Width="14" Height="14" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="Commit..." FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button x:Name="PushBtn" Classes="branch-action" Click="Push_Click">
                        <DockPanel>
                            <Path Data="M4,12V4H20V12H15L12,9L9,12H4M4,14H9L12,11L15,14H20V16H4V14Z"
                                  Fill="#5DA656" Width="14" Height="14" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="Push..." FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Separator Background="{DynamicResource ThemeBorderLowBrush}" Height="1" Margin="8,4"/>
                    <Button x:Name="NewBranchBtn" Classes="branch-action" Click="NewBranch_Click">
                        <DockPanel>
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                  Fill="#5DA656" Width="14" Height="14" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="New Branch..." FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Classes="branch-action" Click="CheckoutTag_Click">
                        <TextBlock Text="Checkout Tag or Revision..." FontSize="12" Margin="22,0,0,0"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Branch tree -->
            <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="BranchList" Margin="0,4,0,8"/>
            </ScrollViewer>
        </Grid>
    </Border>

    <UserControl.Styles>
        <Style Selector="Button.branch-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.branch-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}"/>
        </Style>
        <Style Selector="Button.branch-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="28,5,12,5"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.branch-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
