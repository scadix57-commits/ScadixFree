<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scadix.Designer.Views.WelcomeCloneView">
    <UserControl.Styles>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Padding="40,40,40,20">
            <StackPanel Spacing="8">
                <TextBlock Text="Get from Version Control" FontSize="24" FontWeight="SemiBold" Foreground="#1F1F1F" />
                <TextBlock Text="Clone a project from a Git repository" FontSize="14" Foreground="#9DA0A8" />
            </StackPanel>
        </Border>

        <!-- Form (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="500" HorizontalAlignment="Left" Margin="40,0,40,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Repository URL" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" x:Name="GitProgress" 
                                     IsIndeterminate="True" Width="100" Height="2" 
                                     VerticalAlignment="Center" Margin="10,0,0,0"
                                     IsVisible="False" />
                    </Grid>
                    <TextBox x:Name="RepoUrl" Watermark="https://github.com/user/repo.git" Height="36" Padding="10,0" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Directory" FontWeight="Medium" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" x:Name="ClonePath" Height="36" Padding="10,0" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="..." Margin="8,0,0,0" Width="36" Height="36" />
                    </Grid>
                </StackPanel>

                <!-- VCS Login (Optional) -->
                <Expander Header="Authentication (Optional)" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16" Margin="0,16,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Username" FontSize="12" Foreground="#444444" />
                            <TextBox x:Name="Username" Height="32" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Password / Token" FontSize="12" Foreground="#444444" />
                            <TextBox x:Name="Password" PasswordChar="*" Height="32" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Footer -->
        <Border Grid.Row="2" Padding="40,20,40,40" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="CloneBtn" Content="Clone" Classes="accent" Width="120" Height="36" />
                <Button x:Name="CancelBtn" Content="Cancel" Width="100" Height="36" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
