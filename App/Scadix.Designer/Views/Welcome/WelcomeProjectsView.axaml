<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scadix.Designer"
             x:Class="Scadix.Designer.Views.WelcomeProjectsView">
    <DockPanel>
        <!-- Header row: "Projects" title + search + clear all -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
            <TextBlock Grid.Column="0" Text="Projects" Foreground="#1F1F1F" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Watermark="🔍  Search projects..." Width="200" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="2" Content="Clear All" Margin="8,0,0,0" FontSize="11" Foreground="#9DA0A8" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="ClearAll_Click" />
        </Grid>

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,160,100" Margin="14,0,14,6">
            <TextBlock Grid.Column="0" Text="Name" Foreground="#9DA0A8" FontSize="11" FontWeight="Medium" />
            <TextBlock Grid.Column="1" Text="Path" Foreground="#9DA0A8" FontSize="11" FontWeight="Medium" />
            <TextBlock Grid.Column="2" Text="Last opened" Foreground="#9DA0A8" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" />
        </Grid>

        <!-- Thin divider -->
        <Border DockPanel.Dock="Top" Height="1" Background="#D8D9DC" Margin="0,0,0,6" />

        <!-- Recent projects list -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProjectsList" ItemsSource="{Binding RecentProjects, Source={x:Static local:MainWindowViewModel.Instance}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RecentProjectEntry">
                        <Button Classes="project-row" Tag="{Binding Path}" x:Name="ProjectItemBtn" Click="OpenRecentProject_Click">
                           
                            
                             <!-- Context menu per row -->
                           <Button.ContextMenu>
                               <ContextMenu>
                                   <MenuItem Header="Open"
                                             Tag="{Binding Path}"
                                             Click="ContextOpen_Click"/>
                                   <Separator/>
                                   <MenuItem Header="Remove from list"
                                             Tag="{Binding}"
                                             Click="ContextRemove_Click"/>
                                   <MenuItem Header="Open in File Explorer"
                                             Tag="{Binding Path}"
                                             Click="ContextOpenExplorer_Click"/>
                               </ContextMenu>
                           </Button.ContextMenu>
                            
                            
                            
                            <Grid ColumnDefinitions="Auto,*,160,100">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{Binding IconColor}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconLetter}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" Foreground="#1F1F1F" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Path}" Foreground="#9DA0A8" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="#9DA0A8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding LastOpened}" Foreground="#9DA0A8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
