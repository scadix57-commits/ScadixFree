<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scadix.Designer"
        x:Class="Scadix.Designer.NewSolutionWindow"
        Title="New Solution"
        Width="900" Height="620"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#F5F5F5">

    <Window.Styles>

        <!-- Category item -->
        <Style Selector="Button.cat-item">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="10,6"/>
            <Setter Property="HorizontalAlignment"     Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius"            Value="6"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="Foreground"              Value="#1F1F1F"/>
        </Style>
        <Style Selector="Button.cat-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0E1E4"/>
        </Style>
        <Style Selector="Button.cat-item.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#CCE8FF"/>
        </Style>
        <Style Selector="Button.cat-item.selected">
            <Setter Property="Foreground" Value="#0066CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Template item -->
        <Style Selector="Button.tpl-item">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="10,8"/>
            <Setter Property="HorizontalAlignment"     Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius"            Value="6"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="Foreground"              Value="#1F1F1F"/>
        </Style>
        <Style Selector="Button.tpl-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8F4FF"/>
        </Style>
        <Style Selector="Button.tpl-item.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#CCE8FF"/>
        </Style>

        <!-- Form label -->
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#444444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth"          Value="130"/>
        </Style>

        <!-- Form TextBox -->
        <Style Selector="TextBox.form-input">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="BorderBrush"     Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush"     Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Form ComboBox -->
        <Style Selector="ComboBox.form-combo">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="BorderBrush"     Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="Background"      Value="#FFFFFF"/>
        </Style>

        <!-- Primary button -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background"  Value="#0078D4"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Height"      Value="32"/>
            <Setter Property="Padding"     Value="20,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#106EBE"/>
        </Style>
        <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#A0C4E8"/>
        </Style>

        <!-- Secondary button -->
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background"  Value="#FFFFFF"/>
            <Setter Property="Foreground"  Value="#1F1F1F"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Height"      Value="32"/>
            <Setter Property="Padding"     Value="20,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F8F8F8"/>
        </Style>

        <Style Selector="Button.btn-secondary.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#DEE6F7"/>
            <Setter Property="BorderBrush" Value="#2B579A"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="6" Background="#C21460">
                    <TextBlock Text="X" Foreground="#FFFFFF" FontWeight="Bold"
                               FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="New Solution"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#1F1F1F" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Body ── -->
        <Grid Grid.Row="1" ColumnDefinitions="220,1,*">

            <!-- ── LEFT: Category list ── -->
            <DockPanel Grid.Column="0" Background="#FAFAFA">

                <!-- Search -->
                <Border DockPanel.Dock="Top"
                        Padding="10,10,10,6">
                    <TextBox x:Name="SearchBox"
                             Watermark="🔍  Search templates..."
                             Classes="form-input"
                             Height="28"
                             TextChanged="SearchBox_TextChanged"/>
                </Border>

                <!-- Category tree -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoryPanel"
                                Margin="8,4,8,8"
                                Spacing="1">

                        <!-- Empty Solution — always at top -->
                        <Button Classes="cat-item"
                                Click="EmptySolution_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🗂" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Empty Solution" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#E0E0E0" Margin="4,6"/>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

            <!-- Divider -->
            <Rectangle Grid.Column="1" Fill="#E0E0E0"/>

            <!-- ── RIGHT: Settings panel ── -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          Background="#FFFFFF">
                <StackPanel Margin="28,20,28,20" Spacing="0">

                    <!-- Selected template name -->
                    <TextBlock x:Name="SelectedTemplateName"
                               Text="Select a template"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#1F1F1F"
                               Margin="0,0,0,20"/>

                    <!-- ── Solution name ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="Solution name:" Classes="form-label"/>
                        <TextBox   Grid.Column="1" x:Name="SolutionNameBox"
                                   Classes="form-input"
                                   Text="MySolution"
                                   TextChanged="SolutionName_TextChanged"/>
                    </Grid>

                    <!-- ── Project name ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="Project name:" Classes="form-label"/>
                        <TextBox   Grid.Column="1" x:Name="ProjectNameBox"
                                   Classes="form-input"
                                   Text="MySolution"/>
                    </Grid>

                    <!-- ── Solution directory ── -->
                    <Grid ColumnDefinitions="130,*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Solution directory:" Classes="form-label"/>
                        <TextBox   Grid.Column="1" x:Name="LocationBox"
                                   Classes="form-input"/>
                        <Button    Grid.Column="2"
                                   Classes="btn-secondary"
                                   Height="28" Width="32"
                                   Padding="0"
                                   Margin="6,0,0,0"
                                   ToolTip.Tip="Browse..."
                                   Click="BrowseLocation_Click">
                            <TextBlock Text="📁" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- Path preview -->
                    <TextBlock x:Name="PathPreview"
                               Foreground="#888888"
                               FontSize="11"
                               Margin="130,0,0,16"
                               TextWrapping="Wrap"/>

                    <!-- ── Git ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Classes="form-label"/>
                        <CheckBox  Grid.Column="1"
                                   x:Name="CreateGitRepo"
                                   Content="Create Git repository"
                                   IsChecked="True"
                                   FontSize="12"/>
                    </Grid>

                    <!-- ── Separator ── -->
                    <Border Height="1" Background="#E8E8E8" Margin="0,0,0,16"/>

                    <!-- ── Target framework ── -->
                    <Grid ColumnDefinitions="130,Auto,Auto,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="Target framework:" Classes="form-label"/>
                        <ComboBox  Grid.Column="1"
                                   x:Name="FrameworkCombo"
                                   Classes="form-combo"
                                   MinWidth="120">
                            <ComboBoxItem>net10.0</ComboBoxItem>
                            <ComboBoxItem>net10.0</ComboBoxItem>
                            <ComboBoxItem>net10.0</ComboBoxItem>
                            <ComboBoxItem>net7.0</ComboBoxItem>
                            <ComboBoxItem>net6.0</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Column="2"
                                   Text="from"
                                   Foreground="#666666"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,0,6,0"/>
                        <ComboBox  Grid.Column="3"
                                   x:Name="SdkCombo"
                                   Classes="form-combo"
                                   MinWidth="100">
                            <ComboBoxItem>SDK 10.0</ComboBoxItem>
                            <ComboBoxItem>SDK 9.0</ComboBoxItem>
                            <ComboBoxItem>SDK 8.0</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <!-- ── Language ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Text="Language:" Classes="form-label"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="LangCSharp"
                                    Content="C#"
                                    Classes="btn-secondary"
                                    Height="28" Padding="14,0"
                                    Click="Language_Click" Tag="C#"/>
                            <Button x:Name="LangVB"
                                    Content="VB"
                                    Classes="btn-secondary"
                                    Height="28" Padding="14,0"
                                    Click="Language_Click" Tag="VB"/>
                        </StackPanel>
                    </Grid>

                    <!-- Warning for existing folder -->
                    <TextBlock x:Name="FolderExistsWarning"
                               Text="Directory already exists. A suffix will be added."
                               Foreground="#D32F2F"
                               FontSize="11"
                               Margin="130,-12,0,16"
                               IsVisible="False" />

                    <!-- ── Type (template short name) ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Text="Type:" Classes="form-label"/>
                        <TextBlock Grid.Column="1" x:Name="TypeLabel"
                                   FontSize="12" Foreground="#1F1F1F"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ── Do not use top-level statements ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,10"
                          x:Name="TopLevelRow">
                        <TextBlock Grid.Column="0" Classes="form-label"/>
                        <CheckBox  Grid.Column="1"
                                   x:Name="NoTopLevel"
                                   Content="Do not use top-level statements"
                                   IsChecked="False"
                                   FontSize="12"/>
                    </Grid>

                    <!-- ── Docker ── -->
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Docker:" Classes="form-label"/>
                        <CheckBox  Grid.Column="1"
                                   x:Name="AddDockerfile"
                                   Content="Add Dockerfile"
                                   IsChecked="False"
                                   FontSize="12"/>
                    </Grid>
                    <Grid ColumnDefinitions="130,*" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Classes="form-label"/>
                        <CheckBox  Grid.Column="1"
                                   x:Name="AddDockerCompose"
                                   Content="Add Docker Compose file"
                                   IsChecked="False"
                                   FontSize="12"/>
                    </Grid>

                    <!-- ── Template description (collapsible) ── -->
                    <Expander Header="Template description"
                              IsExpanded="False"
                              Margin="0,0,0,8">
                        <TextBlock x:Name="TemplateDescription"
                                   Text="Select a template to see its description."
                                   Foreground="#666666"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </Expander>




                    <!-- ── Advanced Settings (collapsible) ── -->
                    <Expander Header="Advanced Settings"
                              IsExpanded="False"
                              Margin="0,0,0,8">
                        <StackPanel Spacing="12" Margin="0,12,0,0">

                            <!-- Enable native AOT -->
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="form-label"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <CheckBox x:Name="NativeAot"
                                              Content="Enable native AOT publish"
                                              IsChecked="False"
                                              FontSize="12"/>
                                    <TextBlock Text="?"
                                               Foreground="#0078D4"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               ToolTip.Tip="Publish the app as native AOT for faster startup and smaller size."/>
                                </StackPanel>
                            </Grid>

                            <!-- Language version -->
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Text="Language version:" Classes="form-label"/>
                                <ComboBox  Grid.Column="1"
                                           x:Name="LangVersionCombo"
                                           Classes="form-combo"
                                           MinWidth="220">
                                    <ComboBoxItem IsSelected="True">Default for chosen framework</ComboBoxItem>
                                    <ComboBoxItem>Latest</ComboBoxItem>
                                    <ComboBoxItem>Preview</ComboBoxItem>
                                    <ComboBoxItem>C# 13.0</ComboBoxItem>
                                    <ComboBoxItem>C# 12.0</ComboBoxItem>
                                    <ComboBoxItem>C# 11.0</ComboBoxItem>
                                    <ComboBoxItem>C# 10.0</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel>
                <!-- Install Templates link -->
                <Button DockPanel.Dock="Left"
                        Classes="btn-secondary"
                        Height="28"
                        Padding="12,0"
                        Click="InstallTemplates_Click">
                    <TextBlock Text="Install Templates..." FontSize="12"/>
                </Button>

                <!-- Create / Cancel -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="CreateBtn"
                            Content="Create"
                            Classes="btn-primary"
                            IsEnabled="False"
                            Click="Create_Click"/>
                    <Button Content="Cancel"
                            Classes="btn-secondary"
                            Click="Cancel_Click"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
