<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scadix.Designer"
        x:Class="Scadix.Designer.TemplateInstallerWindow"
        Title="Template Manager"
        Width="720" Height="560"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        CanResize="True">

    <Window.Styles>
        <Style Selector="Button.btn-primary">
            <Setter Property="Background"  Value="#0078D4"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#106EBE"/>
        </Style>
        <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#A0C4E8"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background"  Value="#D32F2F"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B71C1C"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background"  Value="White"/>
            <Setter Property="Foreground"  Value="#1F1F1F"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding"  Value="14,8"/>
        </Style>

        <!-- ── Slim modern scrollbar ── -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Width="8">
                        <Track Name="PART_Track"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="Vertical">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_LineUpButton"
                                              Classes="largeChange"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="0"
                                             IsVisible="False"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_LineDownButton"
                                              Classes="largeChange"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="0"
                                             IsVisible="False"/>
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb"
                                   MinHeight="24"
                                   HorizontalAlignment="Center"
                                   Width="6">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Name="ThumbVisual"
                                                Background="#BBBBBB"
                                                CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover /template/ Border#ThumbVisual">
            <Setter Property="Background" Value="#888888"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed /template/ Border#ThumbVisual">
            <Setter Property="Background" Value="#0078D4"/>
        </Style>

        <!-- ── ScrollViewer ── -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="Template Manager"
                       FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F"/>
            <TextBlock Text="Install, uninstall, and manage .NET project templates."
                       FontSize="12" Foreground="#666666"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" Padding="0">

            <!-- ── Tab 1: Essential Packages ── -->
            <TabItem Header="Essential Packages">
                <Grid RowDefinitions="*,Auto" Margin="0,10,0,0">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PackageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TemplatePackage">
                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding PackageId}" FontSize="11"
                                                           Foreground="#888888" FontFamily="Consolas,Monospace"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="#666666" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           FontWeight="SemiBold" Margin="0,4,0,0">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock[Text=Installed]">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </Style>
                                                        <Style Selector="TextBlock[Text=Missing]">
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </Style>
                                                        <Style Selector="TextBlock[Text=Installing]">
                                                            <Setter Property="Foreground" Value="#0078D4"/>
                                                        </Style>
                                                        <Style Selector="TextBlock[Text=Uninstalling]">
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </Style>
                                                        <Style Selector="TextBlock[Text=Error]">
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Install"
                                                        Classes="btn-primary"
                                                        IsVisible="{Binding !IsInstalled}"
                                                        Click="Install_Click"
                                                        Tag="{Binding}"/>
                                                <Button Content="Uninstall"
                                                        Classes="btn-danger"
                                                        IsVisible="{Binding IsInstalled}"
                                                        Click="Uninstall_Click"
                                                        Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="InstallAllBtn" Content="Install All Missing"
                                Classes="btn-primary" Click="InstallAll_Click"/>
                        <Button Content="Refresh" Classes="btn-secondary" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ── Tab 2: All Installed Templates ── -->
            <TabItem Header="Installed Templates">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <!-- Search -->
                    <TextBox Grid.Row="0"
                             x:Name="SearchBox"
                             Watermark="🔍  Search templates..."
                             Height="30" Margin="0,0,0,8"
                             TextChanged="SearchBox_TextChanged"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="InstalledList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:InstalledTemplateItem">
                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <!-- Icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                       FontSize="18" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ShortName}"
                                                               FontSize="10" Foreground="#0078D4"
                                                               FontFamily="Consolas,Monospace"/>
                                                    <TextBlock Text="{Binding Language}"
                                                               FontSize="10" Foreground="#888888"/>
                                                    <TextBlock Text="{Binding Tags}"
                                                               FontSize="10" Foreground="#AAAAAA"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Category badge -->
                                            <Border Grid.Column="2"
                                                    Background="#EEF4FF"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10" Foreground="#0066CC"/>
                                            </Border>
                                            <!-- Uninstall -->
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Classes="btn-danger"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Uninstall this template"
                                                    Click="UninstallTemplate_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Count + Reload -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" x:Name="TemplateCountLabel"
                                   FontSize="11" Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Reload List"
                                Classes="btn-secondary" Click="ReloadTemplates_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Tab 3: Add Custom Package ── -->
            <TabItem Header="Add Package">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,16,0,4">
                    <TextBlock Text="Install a template package by NuGet package ID:"
                               FontSize="12" Foreground="#444444"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 x:Name="PackageIdBox"
                                 Watermark="e.g.  Microsoft.DotNet.Common.ProjectTemplates.10.0"
                                 Height="32"/>
                        <Button Grid.Column="1"
                                x:Name="AddPackageBtn"
                                Content="Install"
                                Classes="btn-primary"
                                Height="32"
                                Click="AddPackage_Click"/>
                    </Grid>

                    <!-- Popular packages -->
                    <TextBlock Text="Popular packages:" FontSize="12" Foreground="#444444" Margin="0,8,0,0"/>
                    <ItemsControl x:Name="PopularList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PopularPackageItem">
                                <Border Background="White" BorderBrush="#E0E0E0"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding PackageId}"
                                                       FontSize="10" Foreground="#0078D4"
                                                       FontFamily="Consolas,Monospace"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11" Foreground="#666666"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Install"
                                                Classes="btn-primary"
                                                VerticalAlignment="Center"
                                                Click="InstallPopular_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Status -->
                    <TextBlock x:Name="AddStatusLabel" FontSize="12"
                               TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="Close"
                Classes="btn-secondary"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>
