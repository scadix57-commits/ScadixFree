<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Scadix.Designer.PageSizeSettings">
    <UserControl.Styles>
        <!--  Modern Styles  -->
        <Style Selector="TextBox.ModernTextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="BorderBrush" Value="#FF007ACC" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="ComboBox.ModernComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="BorderBrush" Value="#FF007ACC" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="35" />
        </Style>

        <Style Selector="Button.ModernButton">
            <Setter Property="Background" Value="#FF007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.ModernButton:pointerover">
            <Setter Property="Background" Value="#FF1C97EA" />
        </Style>

        <Style Selector="Button.ModernButton:pressed">
            <Setter Property="Background" Value="#FF005A9E" />
        </Style>

        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="#FF6C757D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#FF5A6268" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Foreground="#FF007ACC"
                Text="Page Size Settings" />
            <TextBlock
                FontSize="14"
                Foreground="#FF666666"
                Text="Configure page dimensions for different platforms" />
        </StackPanel>

        <!--  Main Content  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Platform Selection  -->
                <Border
                    BorderBrush="#FFDDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5"
                    Padding="10">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FF333333"
                            Margin="0,0,0,10"
                            Text="Platform Selection - " />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="0"
                                Text="Target Platform:"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Classes="ModernComboBox"
                                Grid.Column="1"
                                SelectionChanged="PlatformComboBox_SelectionChanged"
                                x:Name="PlatformComboBox">
                                <ComboBoxItem Content="WPF Application" />
                                <ComboBoxItem Content="Avalonia UI" />
                                <ComboBoxItem Content="MAUI Application" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Preset Sizes  -->
                <Border
                    BorderBrush="#FFDDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5"
                    Padding="10">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FF333333"
                            Margin="0,0,0,10"
                            Text="Preset Sizes " />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="0"
                                Text="Preset:"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Classes="ModernComboBox"
                                Grid.Column="1"
                                SelectionChanged="PresetComboBox_SelectionChanged"
                                x:Name="PresetComboBox" />
                            <Button
                                Classes="ModernButton"
                                Click="ApplyPresetButton_Click"
                                Content="Apply"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                x:Name="ApplyPresetButton" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Custom Dimensions  -->
                <Border
                    BorderBrush="#FFDDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5"
                    Padding="10">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FF333333"
                            Margin="0,0,0,10"
                            Text="Custom Dimensions" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Width  -->
                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="0"
                                Grid.Row="0"
                                Text="Width:"
                                VerticalAlignment="Center" />
                            <TextBox
                                Classes="ModernTextBox"
                                Grid.Column="1"
                                Grid.Row="0"
                                TextChanged="DimensionTextBox_TextChanged"
                                x:Name="WidthTextBox" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="2"
                                Grid.Row="0"
                                Text="px"
                                VerticalAlignment="Center" />

                            <!--  Height  -->
                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="0"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                Text="Height:"
                                VerticalAlignment="Center" />
                            <TextBox
                                Classes="ModernTextBox"
                                Grid.Column="1"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                TextChanged="DimensionTextBox_TextChanged"
                                x:Name="HeightTextBox" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="2"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                Text="px"
                                VerticalAlignment="Center" />

                            <!--  Aspect Ratio  -->
                            <CheckBox
                                Content="Maintain Aspect Ratio"
                                FontSize="13"
                                Foreground="#FF333333"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Grid.Row="2"
                                Margin="0,15,0,0"
                                x:Name="MaintainAspectRatioCheckBox" />

                            <!--  Orientation  -->
                            <StackPanel
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Grid.Row="3"
                                Margin="0,15,0,0"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#FF333333"
                                    Text="Orientation:"
                                    VerticalAlignment="Center" />
                                <RadioButton
                                    Content="Portrait "
                                    FontSize="13"
                                    Foreground="#FF333333"
                                    GroupName="Orientation"
                                    Margin="10,0,20,0"
                                    x:Name="PortraitRadioButton" />
                                <RadioButton
                                    Content="Landscape"
                                    FontSize="13"
                                    Foreground="#FF333333"
                                    GroupName="Orientation"
                                    x:Name="LandscapeRadioButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Preview  -->
                <Border
                    BorderBrush="#FFDDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5"
                    Padding="10">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FF333333"
                            Margin="0,0,0,10"
                            Text="Preview " />
                        <Border
                            Background="#FFF8F9FA"
                            BorderBrush="#FFDDDDDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="200">
                            <Canvas ClipToBounds="True" x:Name="PreviewCanvas">
                                <Rectangle
                                    Fill="#FF007ACC"
                                    Opacity="0.3"
                                    Stroke="#FF007ACC"
                                    StrokeThickness="2"
                                    x:Name="PreviewRectangle" />
                                <TextBlock
                                    Canvas.Left="10"
                                    Canvas.Top="10"
                                    FontSize="12"
                                    Foreground="#FF333333"
                                    x:Name="PreviewLabel" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  Footer Buttons  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            Orientation="Horizontal">
            <Button
                Classes="SecondaryButton"
                Click="ResetButton_Click"
                Content="Reset "
                Margin="0,0,10,0"
                x:Name="ResetButton" />
            <Button
                Classes="SecondaryButton"
                Click="CancelButton_Click"
                Content="Cancel"
                Margin="0,0,10,0"
                x:Name="CancelButton" />
            <Button
                Classes="ModernButton"
                Click="ApplyButton_Click"
                Content="Apply"
                x:Name="ApplyButton" />
        </StackPanel>

    </Grid>
</UserControl>
