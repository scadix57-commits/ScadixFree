<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:Scadix.Designer"
			 x:Class="Scadix.Designer.ToolbarView"
			 x:DataType="local:MainWindowViewModel"
			 Background="#F5F5F5"
			 Height="32">

	<Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Background="#F5F5F5">
		<DockPanel Margin="4,0">

			<!-- ── Right: workspace status ── -->
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

				<!-- Runtime Warning -->
				<Border Background="#DC3545"
						CornerRadius="4"
						Padding="8,0"
						Height="22"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						IsVisible="{Binding MissingRuntimeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="⚠" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding MissingRuntimeMessage}"
								   Foreground="White"
								   FontSize="11"
								   FontWeight="SemiBold"
								   VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<TextBlock Text="{Binding BuildStatus}"
						   Foreground="#888888"
						   FontSize="11"
						   VerticalAlignment="Center"
						   Margin="0,0,8,0"/>
			</StackPanel>

			<!-- ── Toolbar groups ── -->
			<StackPanel Orientation="Horizontal"
						VerticalAlignment="Center"
						Spacing="2">

				<!-- ════ GROUP 1: Home ════ -->
				<Button Classes="toolbar-btn"
						ToolTip.Tip="Home — Show Welcome Screen"
						Click="Home_Click">
					<TextBlock Text="🏠" FontSize="13" FontFamily="Segoe UI Emoji"/>
				</Button>

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 3: Save ════ -->
				<Button Classes="toolbar-btn"
						ToolTip.Tip="Save (Ctrl+S)"
						Command="{Binding SaveCurrentDocument}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="💾" FontSize="12" FontFamily="Segoe UI Emoji"/>
						<TextBlock Text="Save"/>
					</StackPanel>
				</Button>

				<Button Classes="toolbar-btn"
						ToolTip.Tip="Save All (Ctrl+Shift+S)"
						Command="{Binding SaveAll}">
					<TextBlock Text="Save All"/>
				</Button>

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 4: Designer ════ -->
				<Button Classes="toolbar-btn"
						ToolTip.Tip="Refresh Designer (F5)"
						Command="{Binding Refresh}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="🔄" FontSize="12" FontFamily="Segoe UI Emoji"/>
						<TextBlock Text="Refresh"/>
					</StackPanel>
				</Button>

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 5: Build / Run ════ -->
				<Button Content="Build"
						Command="{Binding BuildCommand}"
						Classes="toolbar-btn build"
						ToolTip.Tip="Build Solution (F6)"/>

				<Button Content="Run"
						Command="{Binding RunCommand}"
						Classes="toolbar-btn run"
						ToolTip.Tip="Run Startup Project (Ctrl+F5)"/>
                <Button Content="Cancel"
                        Command="{Binding CancelBuildCommand}"
                        IsVisible="{Binding IsBuildRunning}"
                        Classes="toolbar-btn"
                        ToolTip.Tip="Cancel Build / Run"/>


				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 6: Debugger Controls ════ -->
				<Button x:Name="BtnStartDebug"
						Classes="toolbar-btn debug"
						ToolTip.Tip="Start Debugging (F5)"
						Click="StartDebug_Click">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
							  Fill="#28A745"
							  Width="12" Height="12"
							  Stretch="Uniform"/>
						<TextBlock Text="Debug"/>
					</StackPanel>
				</Button>

				<Button x:Name="BtnStopDebug"
						Classes="toolbar-btn"
						ToolTip.Tip="Stop Debugging (Shift+F5)"
						Click="StopDebug_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Rectangle Fill="#DC3545" Width="10" Height="10"/>
						<TextBlock Text="Stop"/>
					</StackPanel>
				</Button>

				<Button x:Name="BtnRestartDebug"
						Classes="toolbar-btn"
						ToolTip.Tip="Restart Debugging (Ctrl+Shift+F5)"
						Click="RestartDebug_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<Path Data="M12,4C14.1,4.1 15.9,5.1 17.2,6.6L15,8.8H22V2L19.6,4.4C17.8,2.6 15.1,1.4 12.2,1.3C7.1,1.1 2.6,4.9 1.6,9.9C0.6,14.9 3.5,19.8 8.4,21.3C13.3,22.8 18.5,20.6 20.7,16L18.4,14.9C16.9,18.1 13.3,19.6 10.1,18.1C6.9,16.6 5.4,13 6.9,9.8C8.3,6.8 11.7,5.2 15,6.2L12,4Z"
						  Fill="#6C757D"
						  Width="12" Height="12"
						  Stretch="Uniform"/>
				</Button>

				<Rectangle x:Name="SepDebug1" Width="1" Fill="#D0D0D0" Margin="4,6" IsVisible="{Binding DebugToolbar.IsDebugging}"/>

				<Button x:Name="BtnContinue"
						Classes="toolbar-btn"
						ToolTip.Tip="Continue (F5)"
						Click="Continue_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
						  Fill="#007BFF"
						  Width="12" Height="12"
						  Stretch="Uniform"/>
				</Button>

				<Button x:Name="BtnPause"
						Classes="toolbar-btn"
						ToolTip.Tip="Pause"
						Click="Pause_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<StackPanel Orientation="Horizontal" Spacing="2">
						<Rectangle Fill="#FFC107" Width="4" Height="10"/>
						<Rectangle Fill="#FFC107" Width="4" Height="10"/>
					</StackPanel>
				</Button>

				<Button x:Name="BtnStepOver"
						Classes="toolbar-btn"
						ToolTip.Tip="Step Over (F10)"
						Click="StepOver_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<Path Data="M14,5V19H16V5M3,5V19L11,12"
						  Fill="#17A2B8"
						  Width="12" Height="12"
						  Stretch="Uniform"/>
				</Button>

				<Button x:Name="BtnStepInto"
						Classes="toolbar-btn"
						ToolTip.Tip="Step Into (F11)"
						Click="StepInto_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<Path Data="M12,4L10.59,5.41L16.17,11H4V13H16.17L10.59,18.59L12,20L20,12L12,4Z"
						  Fill="#17A2B8"
						  Width="12" Height="12"
						  Stretch="Uniform"/>
				</Button>

				<Button x:Name="BtnStepOut"
						Classes="toolbar-btn"
						ToolTip.Tip="Step Out (Shift+F11)"
						Click="StepOut_Click"
						IsEnabled="False"
						IsVisible="{Binding DebugToolbar.IsDebugging}">
					<Path Data="M19,7V11H5.83L11.41,5.41L10,4L2,12L10,20L11.41,18.59L5.83,13H21V7H19Z"
						  Fill="#17A2B8"
						  Width="12" Height="12"
						  Stretch="Uniform"/>
				</Button>

				<Rectangle x:Name="SepDebug2" Width="1" Fill="#D0D0D0" Margin="4,6" IsVisible="{Binding DebugToolbar.IsDebugging}"/>

				<Button x:Name="BtnAttachToProcess"
						Classes="toolbar-btn"
						ToolTip.Tip="Attach to Process (Ctrl+Alt+P)"
						Click="AttachToProcess_Click">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<Path Data="M16,9V7H12V12.5C13.38,12.5 14.5,13.62 14.5,15C14.5,16.38 13.38,17.5 12,17.5C10.62,17.5 9.5,16.38 9.5,15C9.5,13.62 10.62,12.5 12,12.5V5H16V3H12C10.89,3 10,3.89 10,5V7H6V9H10V12.5C8.62,12.5 7.5,13.62 7.5,15C7.5,16.38 8.62,17.5 10,17.5H14C15.11,17.5 16,16.61 16,15.5V9Z"
							  Fill="#6C757D"
							  Width="12" Height="12"
							  Stretch="Uniform"/>
						<TextBlock Text="Attach"/>
					</StackPanel>
				</Button>

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 6: Config + Startup ════ -->
				<TextBlock Text="Config:"
						   Classes="toolbar-label"
						   Margin="0,0,3,0"/>
				<ComboBox ItemsSource="{Binding Configurations}"
						  SelectedItem="{Binding Configuration}"
						  Classes="toolbar-combo"
						  MinWidth="80" />

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<TextBlock Text="Startup:"
						   Classes="toolbar-label"
						   Margin="0,0,3,0"/>
				<ComboBox x:Name="StartupCombo"
						  ItemsSource="{Binding StartupProjects}"
						  SelectedItem="{Binding SelectedStartupProject}"
						  Classes="toolbar-combo"
						  MinWidth="180">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="{Binding Name}" FontSize="12"/>
								<TextBlock Text="{Binding Badge}"
										   Foreground="#888888"
										   FontSize="12"
										   IsVisible="{Binding HasBadge}"/>
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Rectangle Width="1" Fill="#D0D0D0" Margin="4,6"/>

				<!-- ════ GROUP 7: Git Branch Widget ════ -->
				<StackPanel Orientation="Horizontal" Spacing="0">
					<Button Classes="toolbar-btn" x:Name="BranchButton" Padding="6,0">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedRight">
								<ContentControl x:Name="BranchFlyoutHost" />
							</Flyout>
						</Button.Flyout>
						<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
							<Path Data="M13,8.5C13,9.7 12.3,10.8 11.3,11.3V12.7C12.3,13.2 13,14.3 13,15.5C13,17.4 11.4,19 9.5,19C7.6,19 6,17.4 6,15.5C6,14.3 6.7,13.2 7.7,12.7V11.3C6.7,10.8 6,9.7 6,8.5C6,6.6 7.6,5 9.5,5C11.4,5 13,6.6 13,8.5Z"
								  Fill="#61AFEF" Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding CurrentGitBranch}" FontSize="12" FontWeight="SemiBold"
									   Foreground="#61AFEF" VerticalAlignment="Center"
									   MaxWidth="150" TextTrimming="CharacterEllipsis"/>
							<Path Data="M7,10L12,15L17,10H7Z" Fill="#888" Width="10" Height="10"
								  Stretch="Uniform" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<!-- Publish Button -->
					<Button Classes="toolbar-btn"
							ToolTip.Tip="Publish to Server"
							Command="{Binding Factory.Git.PushAsync}">
						<Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"
							  Fill="#666666" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
					</Button>
					<!-- ── Page Size Group ── -->

					<Grid RowDefinitions="*,Auto">
						<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
							<TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
							<TextBox x:Name="PageWidthBox"
									 Width="48" Height="22" FontSize="11"
									 Watermark="W" VerticalContentAlignment="Center"
									 KeyDown="PageDimension_KeyDown"
									 LostFocus="PageDimension_LostFocus"
									 TextAlignment="Center" CornerRadius="3"

									 ToolTip.Tip="Page Width (px)" />
							<TextBlock Text="×" FontSize="11" VerticalAlignment="Center" Foreground="#888" />
							<TextBox x:Name="PageHeightBox"
									 Width="48" Height="22" FontSize="11"
									 Watermark="H" VerticalContentAlignment="Center"
									 KeyDown="PageDimension_KeyDown"
									 LostFocus="PageDimension_LostFocus"
									 TextAlignment="Center" CornerRadius="3"

									 ToolTip.Tip="Page Height (px)" />
							<ComboBox x:Name="PagePresetCombo"
									  Width="120" Height="22" FontSize="10" SelectionChanged="PagePreset_SelectionChanged"
									  PlaceholderText="Preset…"

									  ToolTip.Tip="Select a device preset">
								<ComboBoxItem Tag="390,844"   Content="iPhone 14" />
								<ComboBoxItem Tag="430,932"   Content="iPhone 14 Pro Max" />
								<ComboBoxItem Tag="360,780"   Content="Galaxy S23" />
								<ComboBoxItem Tag="768,1024"  Content="iPad" />
								<ComboBoxItem Tag="800,1280"  Content="Android Tablet" />
								<ComboBoxItem Tag="1280,720"  Content="HD 720p" />
								<ComboBoxItem Tag="1366,768"  Content="Laptop 1366" />
								<ComboBoxItem Tag="1920,1080" Content="Full HD" />
								<ComboBoxItem Tag="1440,900"  Content="macOS 1440" />
								<ComboBoxItem Tag="3840,2160" Content="4K UHD" />
								<ComboBoxItem Tag="390,390"   Content="Square 390" />
								<ComboBoxItem Tag="800,600"   Content="Small Window" />
							</ComboBox>
						</StackPanel>

					</Grid>

				</StackPanel>

			</StackPanel>
		</DockPanel>
	</Border>
</UserControl>
