<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Scadix.Designer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              xmlns:Services="clr-namespace:Scadix.AxamlDesigner.Services;assembly=Scadix.AxamlDesigner"
             Background="#FFFFFF"
             x:Class="Scadix.Designer.ProblemsToolView">
  <Border BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
        <DockPanel>

            <!-- ── Header ── -->
            <Border DockPanel.Dock="Top"
                    Background="#F5F5F5"
                    Height="26"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="4,0">

                    <!-- Right: close/collapse -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Margin="0,0,6,0">
                        <TextBlock Text="▼" Foreground="#888888" FontSize="9"
                                   VerticalAlignment="Center" Cursor="Hand"/>
                        <TextBlock Text="✕" Foreground="#888888" FontSize="9"
                                   VerticalAlignment="Center" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Left: title + filter tabs + count -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="Error List"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1E1E1E"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"/>

                        <!-- Errors tab (active) -->
                        <Border Height="22" Padding="8,0" CornerRadius="3"
                                Background="#FFFFFF"
                                BorderBrush="#0078D4" BorderThickness="1"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="avares://Scadix.Designer/Images/Error.png"
                                       Stretch="None"
                                       VerticalAlignment="Center"/>
                                <TextBlock x:Name="ErrorCountText"
                                           Text="0 Errors"
                                           FontSize="11"
                                           Foreground="#0078D4"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Warnings tab -->
                        <Border Height="22" Padding="8,0" CornerRadius="3"
                                Background="Transparent"
                                BorderBrush="#C0C0C0" BorderThickness="1"
                                Cursor="Hand" Margin="2,0">
                            <TextBlock Text="Warnings"
                                       FontSize="11"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Messages tab -->
                        <Border Height="22" Padding="8,0" CornerRadius="3"
                                Background="Transparent"
                                BorderBrush="#C0C0C0" BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="Messages"
                                       FontSize="11"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Footer tabs ── -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F5F5F5"
                    Height="24"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0"
                            Spacing="0">
                    <Border Padding="8,0" Height="24" Cursor="Hand">
                        <TextBlock Text="Error List"
                                   FontSize="11"
                                   Foreground="#1E1E1E"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Padding="8,0" Height="24" Cursor="Hand">
                        <TextBlock Text="Output"
                                   FontSize="11"
                                   Foreground="#555555"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Column headers ── -->
            <Border DockPanel.Dock="Top"
                    Background="#F5F5F5"
                    Height="20"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Line"
                               Foreground="#666666" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Col"
                               Foreground="#666666" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Description"
                               Foreground="#666666" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Error rows ── -->
            <ScrollViewer Background="#FFFFFF">
                <ItemsControl x:Name="PART_Items" x:DataType="local:MainWindowViewModel" Margin="8,4" ItemsSource="{Binding CurrentDocument.XamlErrorService.Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="Services:XamlError">
                            <Grid MinHeight="28" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Error icon -->
                                <Image Grid.Column="0"
                                       Source="avares://Scadix.Designer/Images/Error.png"
                                       Stretch="None"
                                       VerticalAlignment="Center"/>

                                <!-- Line -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Line}"
                                           Foreground="#1E1E1E"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- Column -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Column}"
                                           Foreground="#1E1E1E"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- Message -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           Foreground="#1E1E1E"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border></UserControl>
