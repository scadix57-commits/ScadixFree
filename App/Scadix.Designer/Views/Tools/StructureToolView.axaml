<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Outline="clr-namespace:Scadix.AxamlDesigner.OutlineView;assembly=Scadix.AxamlDesigner"
             xmlns:local="clr-namespace:Scadix.Designer"
             x:Class="Scadix.Designer.OutlineToolView">
    <Outline:Outline x:DataType="local:MainWindowViewModel"
                     Root="{Binding CurrentDocument.OutlineRoot}" />
</UserControl>
