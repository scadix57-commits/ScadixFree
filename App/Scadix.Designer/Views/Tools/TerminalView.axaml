<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels.Tools"
             x:Class="Scadix.Designer.Views.Tools.TerminalView"
             x:DataType="vm:TerminalViewModel"
             Background="#1E1E1E">

  <Grid RowDefinitions="Auto,*">

    <!-- ══ Session Tab Bar ════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">

        <!-- Session Tabs -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TerminalSession">
                <Border x:Name="SessionTab"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1,0,1,0"
                        Padding="10,5">
                  <Border.Styles>
                    <Style Selector="Border:pointerover">
                      <Setter Property="Background" Value="#2D2D30"/>
                    </Style>
                  </Border.Styles>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Shell indicator dot -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                      <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding IsAlive, Converter={x:Static vm:TerminalConverters.AliveToColor}}"/>
                      </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding Title}"
                               FontSize="11" Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                    <!-- Close session -->
                    <Button Background="Transparent" BorderThickness="0" Padding="2"
                            Command="{Binding $parent[UserControl].((vm:TerminalViewModel)DataContext).CloseSessionCommand}"
                            CommandParameter="{Binding}"
                            VerticalAlignment="Center">
                      <TextBlock Text="✕" FontSize="9" Foreground="#888"/>
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- New Terminal Button -->
        <Button Grid.Column="1"
                Command="{Binding NewSessionCommand}"
                Background="Transparent" BorderThickness="0"
                Padding="8,4" VerticalAlignment="Center"
                ToolTip.Tip="New Terminal (Ctrl+`)">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="+" FontSize="16" Foreground="#AAAAAA" VerticalAlignment="Center"/>
            <TextBlock Text="New" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ══ Session Content ════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1">

      <!-- Welcome Screen (no sessions) -->
      <StackPanel IsVisible="{Binding !ActiveSession, FallbackValue=False}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="12">
        <TextBlock Text="⌨" FontSize="48" Foreground="#444" HorizontalAlignment="Center"/>
        <TextBlock Text="No active terminal session"
                   FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
        <Button Content="Open New Terminal"
                Command="{Binding NewSessionCommand}"
                HorizontalAlignment="Center"
                Padding="16,8" CornerRadius="4"
                Background="#0E639C" Foreground="White" BorderThickness="0"/>
      </StackPanel>

      <!-- Active Session — IsVisible checked at TerminalViewModel level -->
      <Panel IsVisible="{Binding ActiveSession, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl Content="{Binding ActiveSession}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:TerminalSession">
              <Grid RowDefinitions="*,Auto">

                <!-- Output Area -->
                <ScrollViewer x:Name="OutputScroll"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0">
                  <ItemsControl ItemsSource="{Binding Output}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TerminalLine">
                        <SelectableTextBlock Text="{Binding Text}"
                                             FontFamily="Cascadia Code, Consolas, monospace"
                                             FontSize="12"
                                             Foreground="{Binding Kind, Converter={x:Static vm:TerminalConverters.KindToForeground}}"
                                             TextWrapping="NoWrap"
                                             Padding="8,0"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- Input Bar -->
                <Border Grid.Row="1"
                        Background="#2D2D30"
                        BorderBrush="#3C3C3C"
                        BorderThickness="0,1,0,0"
                        Padding="4">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                    <!-- Prompt symbol -->
                    <TextBlock Grid.Column="0" Text="❯"
                               FontSize="14" Foreground="#0E639C"
                               VerticalAlignment="Center" Margin="4,0,6,0"/>

                    <!-- Input TextBox -->
                    <TextBox Grid.Column="1"
                             x:Name="InputBox"
                             Text="{Binding Input}"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="12"
                             Foreground="#FFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="#FFFFFF"
                             Watermark="Type a command..."
                             VerticalAlignment="Center"/>

                    <!-- History Up/Down -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                      <Button Background="Transparent" BorderThickness="0" Padding="4,2"
                              Command="{Binding HistoryUpCommand}"
                              ToolTip.Tip="Previous command (↑)">
                        <PathIcon Data="M7 14l5-5 5 5z" Width="12" Height="12" Foreground="#666"/>
                      </Button>
                      <Button Background="Transparent" BorderThickness="0" Padding="4,2"
                              Command="{Binding HistoryDownCommand}"
                              ToolTip.Tip="Next command (↓)">
                        <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#666"/>
                      </Button>
                    </StackPanel>

                    <!-- Clear -->
                    <Button Grid.Column="3"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Command="{Binding ClearScreenCommand}"
                            ToolTip.Tip="Clear screen (Ctrl+L)">
                      <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                Width="13" Height="13" Foreground="#666"/>
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Panel>
    </Grid>
  </Grid>

</UserControl>
