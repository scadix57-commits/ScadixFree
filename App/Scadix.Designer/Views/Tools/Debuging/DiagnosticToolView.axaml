<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Scadix.Designer.ViewModels.Tools"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="Scadix.Designer.Views.Tools.DiagnosticToolView"
             x:DataType="vm:DiagnosticToolViewModel"
             Background="#F5F5F5">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ══════════════ TOP TOOLBAR ══════════════ -->
    <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="4,3">
      <StackPanel Orientation="Horizontal" Spacing="2">

        <!-- Reset View -->
        <Button Padding="5,3" Background="Transparent" BorderThickness="0"
                Command="{Binding ClearCommand}"
                ToolTip.Tip="Reset View / Clear Data">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12H18A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6Z"
                       Width="13" Height="13" Foreground="#666"/>
            <TextBlock Text="Reset View" FontSize="11" VerticalAlignment="Center" Foreground="#777"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </Border>

    <!-- ══════════════ CHARTS AREA ══════════════ -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="0">

        <!-- Session timer bar -->
        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,3">
          <TextBlock FontSize="11" Foreground="#555">
            <Run Text="Diagnostics session: "/>
            <Run Text="{Binding SessionTime}" FontWeight="SemiBold" Foreground="#222"/>
          </TextBlock>
        </Border>

        <!-- ── Process Memory section ─────────────────────────────────── -->
        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Command="{Binding ToggleMemoryCommand}"
                      Background="Transparent" BorderThickness="0"
                      HorizontalContentAlignment="Left" Padding="6,3">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#555"/>
                  <TextBlock Text="Process Memory (MB)" FontSize="11" FontWeight="SemiBold" Foreground="#333"/>
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0"
                          VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#0078D4"/>
                <TextBlock Text="Private Bytes" FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Border IsVisible="{Binding MemoryExpanded}"
                    Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
              <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2">
                  <TextBlock FontSize="10" Foreground="#1E90FF" FontWeight="Bold"
                             Text="{Binding Metrics.MemoryUsageMb, StringFormat='{}{0:N0}'}"/>
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1" Height="80"
                                    Series="{Binding MemorySeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding MemoryYAxes}"
                                    TooltipPosition="Hidden"
                                    Margin="0"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- ── CPU section ────────────────────────────────────────────── -->
        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
          <StackPanel>
            <Button Command="{Binding ToggleCpuCommand}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Left" Padding="6,3">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#555"/>
                <TextBlock Text="CPU (% of all processors)" FontSize="11" FontWeight="SemiBold" Foreground="#333"/>
              </StackPanel>
            </Button>
            <Border IsVisible="{Binding CpuExpanded}"
                    Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
              <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2">
                  <TextBlock FontSize="10" Foreground="#1E90FF" FontWeight="Bold"
                             Text="{Binding Metrics.CpuUsage, StringFormat='{}{0:N1}%'}"/>
                  <TextBlock FontSize="10" Foreground="#888" Text=" / 100" Margin="0"/>
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1" Height="80"
                                    Series="{Binding CpuSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding CpuYAxes}"
                                    TooltipPosition="Hidden"
                                    Margin="0"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ══════════════ BOTTOM TABS ══════════════ -->
    <TabControl Grid.Row="2"
                BorderThickness="0,1,0,0" BorderBrush="#CCCCCC"
                Background="#F5F5F5">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="Padding"  Value="8,4"/>
        </Style>
      </TabControl.Styles>

      <!-- Summary tab -->
      <TabItem Header="Summary">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,6" Spacing="12">

            <!-- .NET Counters group -->
            <StackPanel Spacing="4">
              <TextBlock Text=".NET Counters" FontSize="11" FontWeight="Bold" Foreground="#333"/>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="CPU:"     FontSize="10" Foreground="#555" VerticalAlignment="Center" Width="80"/>
                <ProgressBar Grid.Column="1" Value="{Binding Metrics.CpuUsage}" Maximum="100"
                             Height="6" CornerRadius="3" Foreground="#0078D4" Background="#E0E0E0"/>
                <TextBlock Grid.Column="2" FontSize="10" Foreground="#333" Margin="6,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Metrics.CpuUsage, StringFormat='{}{0:N1}%'}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Memory:" FontSize="10" Foreground="#555" VerticalAlignment="Center" Width="80"/>
                <ProgressBar Grid.Column="1" Value="{Binding Metrics.MemoryUsageMb}" Maximum="4096"
                             Height="6" CornerRadius="3" Foreground="#0078D4" Background="#E0E0E0"/>
                <TextBlock Grid.Column="2" FontSize="10" Foreground="#333" Margin="6,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Metrics.MemoryUsageMb, StringFormat='{}{0:N0} MB'}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="GC Heap:" FontSize="10" Foreground="#555" VerticalAlignment="Center" Width="80"/>
                <ProgressBar Grid.Column="1" Value="{Binding Metrics.GcHeapSizeMb}" Maximum="4096"
                             Height="6" CornerRadius="3" Foreground="#16825D" Background="#E0E0E0"/>
                <TextBlock Grid.Column="2" FontSize="10" Foreground="#333" Margin="6,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Metrics.GcHeapSizeMb, StringFormat='{}{0:N0} MB'}"/>
              </Grid>
            </StackPanel>

            <Border Height="1" Background="#E0E0E0"/>

            <!-- Memory Usage group -->
            <StackPanel Spacing="4">
              <TextBlock Text="Memory Usage" FontSize="11" FontWeight="Bold" Foreground="#333"/>
              <Button Command="{Binding TakeSnapshotCommand}"
                      Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"
                             Width="13" Height="13" Foreground="#0078D4"/>
                  <TextBlock Text="Take Snapshot" FontSize="11" Foreground="#0066CC" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock IsVisible="{Binding SnapshotCount}"
                         FontSize="10" Foreground="#888" Margin="19,0,0,0"
                         Text="{Binding SnapshotCount, StringFormat='{}({0} snapshot(s) taken)'}"/>
            </StackPanel>

            <Border Height="1" Background="#E0E0E0"/>

            <!-- CPU Usage group -->
            <StackPanel Spacing="4">
              <TextBlock Text="CPU Usage" FontSize="11" FontWeight="Bold" Foreground="#333"/>
              <Button Command="{Binding ToggleCpuRecordingCommand}"
                      Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="#888888"/>
                  <TextBlock FontSize="11" Foreground="#0066CC" VerticalAlignment="Center"
                             Text="{Binding IsRecordingCpu, ConverterParameter='Stop Recording,Start Recording'}"/>
                </StackPanel>
              </Button>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Counters tab -->
      <TabItem Header="Counters">
        <ScrollViewer>
          <StackPanel Margin="10,6" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="cpu-usage"    FontSize="11" Foreground="#333"/>
              <TextBlock Grid.Column="1" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold"
                         Text="{Binding Metrics.CpuUsage, StringFormat='{}{0:N2}%'}"/>
            </Grid>
            <Border Height="1" Background="#EEEEEE"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="working-set"  FontSize="11" Foreground="#333"/>
              <TextBlock Grid.Column="1" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold"
                         Text="{Binding Metrics.MemoryUsageMb, StringFormat='{}{0:N1} MB'}"/>
            </Grid>
            <Border Height="1" Background="#EEEEEE"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="gc-heap-size" FontSize="11" Foreground="#333"/>
              <TextBlock Grid.Column="1" FontSize="11" Foreground="#16825D" FontWeight="SemiBold"
                         Text="{Binding Metrics.GcHeapSizeMb, StringFormat='{}{0:N1} MB'}"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Memory Usage tab -->
      <TabItem Header="Memory Usage">
        <ScrollViewer>
          <StackPanel Margin="10,6" Spacing="4">
            <TextBlock Text="Snapshots" FontSize="11" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Snapshots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SnapshotEntry">
                  <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,3">
                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#444"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding !SnapshotCount}"
                       Text="No snapshots yet. Click 'Take Snapshot' in the Summary tab."
                       FontSize="11" Foreground="#999"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CPU Usage tab -->
      <TabItem Header="CPU Usage">
        <Grid>
          <lvc:CartesianChart Series="{Binding CpuSeries}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding CpuYAxes}"
                              TooltipPosition="Hidden"
                              Margin="8"/>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
