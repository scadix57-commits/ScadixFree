<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels.Tools"
             x:Class="Scadix.Designer.Views.Tools.LocalsView"
             x:DataType="vm:LocalsViewModel"
             Background="{DynamicResource ThemeBackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ThemeControlMidBrush}">
      <Grid ColumnDefinitions="*,2*,*">
        <TextBlock Text="Name" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" />
      </Grid>
    </Border>
    <ListBox Grid.Row="1" x:Name="VariablesList" ItemsSource="{Binding Variables}"
             BorderThickness="0" Background="Transparent">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="10,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:VariableViewModel">
          <Grid ColumnDefinitions="*,2*,*">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Value}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Text="{Binding Type}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Type}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="No local variables. Pause debugging to inspect the current frame."
               IsVisible="{Binding !Variables.Count}" Margin="12" TextWrapping="Wrap"
               IsHitTestVisible="False" />
  </Grid>
</UserControl>
