<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Scadix.Designer.ViewModels.Tools"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Scadix.Designer.Views.Tools.CallStackView"
             x:DataType="vm:CallStackViewModel">
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Call Stack" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Frames}"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  Background="Transparent"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"           Width="*"/>
                <DataGridTextColumn Header="Location" Binding="{Binding SourceLocation}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
