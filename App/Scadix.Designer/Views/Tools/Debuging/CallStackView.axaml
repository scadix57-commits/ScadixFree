<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels.Tools"
             x:Class="Scadix.Designer.Views.Tools.CallStackView"
             x:DataType="vm:CallStackViewModel"
             Background="{DynamicResource ThemeBackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ThemeControlMidBrush}">
      <Grid ColumnDefinitions="2*,*">
        <TextBlock Text="Function" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="Location" FontWeight="SemiBold" />
      </Grid>
    </Border>
    <ListBox Grid.Row="1" x:Name="FramesList" ItemsSource="{Binding Frames}"
             BorderThickness="0" Background="Transparent">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="10,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StackFrameViewModel">
          <Grid ColumnDefinitions="2*,*">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding SourceLocation}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceLocation}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="No stack frames. Pause debugging to inspect the call stack."
               IsVisible="{Binding !Frames.Count}" Margin="12" TextWrapping="Wrap"
               IsHitTestVisible="False" />
  </Grid>
</UserControl>
