<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:designer="using:Scadix.Designer"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Scadix.Designer.ViewModels"
             xmlns:local="clr-namespace:Scadix.Designer"
             x:Class="Scadix.Designer.Views.Tools.GitChangesView"
             x:DataType="vm:GitChangesViewModel">

    <UserControl.Resources>
        <designer:PathToNameConverter x:Key="PathToNameConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- ══ Row 0: Branch selector + action buttons ══ -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1" Padding="6,5">
            <DockPanel LastChildFill="True">

                <!-- Action buttons FIRST so DockPanel reserves space for them -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">

                    <!-- Pull with Rebase -->
                    <Button Height="26" Width="26" Padding="3"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            ToolTip.Tip="Pull with Rebase"
                            IsVisible="{Binding ShowPullButton}"
                            Command="{Binding PullRebaseAsync}">
                        <Canvas Width="14" Height="14">
                            <!-- arrow down -->
                            <Line StartPoint="7,1" EndPoint="7,10"
                                  Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6"/>
                            <Polyline Points="4,7 7,11 10,7"
                                      Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6" Fill="Transparent"/>
                            <!-- base line -->
                            <Line StartPoint="2,13" EndPoint="12,13"
                                  Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6"/>
                        </Canvas>
                    </Button>

                    <!-- Pull -->
                    <Button Height="26" Width="26" Padding="3"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            ToolTip.Tip="Pull"
                            IsVisible="{Binding ShowPullButton}"
                            Command="{Binding PullAsync}">
                        <Canvas Width="14" Height="14">
                            <Line StartPoint="7,1" EndPoint="7,11"
                                  Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6"/>
                            <Polyline Points="4,7 7,11 10,7"
                                      Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6" Fill="Transparent"/>
                        </Canvas>
                    </Button>

                    <!-- Push -->
                    <Button Height="26" Width="26" Padding="3"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            ToolTip.Tip="Push"
                            IsVisible="{Binding ShowPushButton}"
                            Command="{Binding PushAsync}">
                        <Canvas Width="14" Height="14">
                            <Line StartPoint="7,13" EndPoint="7,3"
                                  Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6"/>
                            <Polyline Points="4,7 7,3 10,7"
                                      Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="1.6" Fill="Transparent"/>
                        </Canvas>
                    </Button>

                    <!-- Sync / Fetch -->
                    <Button Height="26" Width="26" Padding="3"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            ToolTip.Tip="Fetch / Sync"
                            IsVisible="{Binding ShowFetchButton}"
                            Command="{Binding FetchAsync}">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource ThemeForegroundBrush}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- More options -->
                    <Button Height="26" Width="26" Padding="3"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="More options">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">

                                <!-- Manage Remotes -->
                                <MenuItem Header="Manage Remotes..."
                                          Command="{Binding ManageRemotesCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M6.5,9L10,12L6.5,15V9M17.5,9V15L14,12L17.5,9Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <!-- Create Repository -->
                                <MenuItem Header="Create Git Repository..."
                                          Command="{Binding CreateGitRepositoryCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- New Branch -->
                                <MenuItem Header="New Branch..."
                                          Command="{Binding NewBranchCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M17,17.5A2.5,2.5 0 0,1 14.5,20A2.5,2.5 0 0,1 12,17.5C12,16.5 12.58,15.65 13.4,15.22V8.78C12.58,8.35 12,7.5 12,6.5A2.5,2.5 0 0,1 14.5,4A2.5,2.5 0 0,1 17,6.5C17,7.5 16.42,8.35 15.6,8.78V15.22C16.42,15.65 17,16.5 17,17.5M9,17.5A2.5,2.5 0 0,1 6.5,20A2.5,2.5 0 0,1 4,17.5C4,16.5 4.58,15.65 5.4,15.22V6.5A2.5,2.5 0 0,1 7.9,4C8.61,4 9.25,4.29 9.7,4.76L8.3,6.17C8.11,6.06 7.86,6 7.6,6A1.5,1.5 0 0,0 6.1,7.5A1.5,1.5 0 0,0 7.6,9C8.06,9 8.47,8.82 8.78,8.53L9.94,10.66C9.29,9.58 8.6,8.81 7.79,8.18C8.23,7.74 8.5,7.15 8.5,6.5A2,2 0 0,0 6.5,4.5A2,2 0 0,0 4.5,6.5A2,2 0 0,0 6.5,8.5C6.96,8.5 7.39,8.34 7.72,8.08C8.59,8.79 9.35,9.66 9.94,10.66C10.53,11.66 10.95,12.75 11.2,13.88C10.5,14.36 10,15.17 10,16.08C10,16.63 10.15,17.15 10.43,17.58C9.97,17.79 9.49,17.9 9,17.9V17.5Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- Manage Branches -->
                                <MenuItem Header="Manage Branches"
                                          Command="{Binding ManageBranchesCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M17,17.5A2.5,2.5 0 0,1 14.5,20A2.5,2.5 0 0,1 12,17.5C12,16.5 12.58,15.65 13.4,15.22V8.78C12.58,8.35 12,7.5 12,6.5A2.5,2.5 0 0,1 14.5,4A2.5,2.5 0 0,1 17,6.5C17,7.5 16.42,8.35 15.6,8.78V15.22C16.42,15.65 17,16.5 17,17.5M9,17.5A2.5,2.5 0 0,1 6.5,20A2.5,2.5 0 0,1 4,17.5C4,16.5 4.58,15.65 5.4,15.22V6.5A2.5,2.5 0 0,1 7.9,4C8.61,4 9.25,4.29 9.7,4.76C9.28,5.2 9,5.82 9,6.5C9,7.66 9.79,8.64 10.87,8.92C10.42,9.37 10.05,9.89 9.8,10.46C9.29,9.58 8.6,8.81 7.79,8.18C8.23,7.74 8.5,7.15 8.5,6.5A2,2 0 0,0 6.5,4.5A2,2 0 0,0 4.5,6.5A2,2 0 0,0 6.5,8.5C6.96,8.5 7.39,8.34 7.72,8.08C8.59,8.79 9.35,9.66 9.94,10.66C10.53,11.66 10.95,12.75 11.2,13.88C10.5,14.36 10,15.17 10,16.08C10,16.63 10.15,17.15 10.43,17.58C9.97,17.79 9.49,17.9 9,17.9V17.5M14.5,5A1.5,1.5 0 0,0 13,6.5A1.5,1.5 0 0,0 14.5,8A1.5,1.5 0 0,0 16,6.5A1.5,1.5 0 0,0 14.5,5M14.5,16A1.5,1.5 0 0,0 13,17.5A1.5,1.5 0 0,0 14.5,19A1.5,1.5 0 0,0 16,17.5A1.5,1.5 0 0,0 14.5,16Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <!-- Open in File Explorer -->
                                <MenuItem Header="Open in File Explorer"
                                          Command="{Binding OpenInFileExplorerCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- Open in Command Prompt -->
                                <MenuItem Header="Open in Command Prompt"
                                          Command="{Binding OpenInTerminalCommand}">
                                    <MenuItem.Icon>
                                        <Path Data="M20,19V7H4V19H20M20,3A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5C2,3.89 2.9,3 4,3H20M13,17V15H18V17H13M9.58,13L8.17,11.58L10.75,9L8.17,6.41L9.58,5L13.58,9L9.58,13Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <!-- Show Toolbar Actions submenu -->
                                <MenuItem Header="Show Toolbar Actions">
                                    <MenuItem.Icon>
                                        <Path Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H15V17H3V15M3,19H21V21H3V19Z"
                                          Fill="{DynamicResource ThemeForegroundBrush}"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="Fetch"
                                              Command="{Binding ToggleFetchVisibleCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="M21,3L3,10.53V11.5L9.84,14.16L12.5,21H13.46L21,3Z"
                                              Fill="{DynamicResource ThemeForegroundBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Pull"
                                              Command="{Binding TogglePullVisibleCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                              Fill="{DynamicResource ThemeForegroundBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Push"
                                              Command="{Binding TogglePushVisibleCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="M5,4H19V6H5M5,15H9V21H15V15H19L12,8L5,15Z"
                                              Fill="{DynamicResource ThemeForegroundBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sync (Pull then Push)"
                                              Command="{Binding ToggleSyncVisibleCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z"
                                              Fill="{DynamicResource ThemeForegroundBrush}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>

                            </MenuFlyout>
                        </Button.Flyout>
                        <TextBlock Text="···" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Repo and Branch Selectors -->
                <Grid ColumnDefinitions="*, *" Margin="0,0,4,0">
                    <!-- Repository Selector -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Repositories}"
                              SelectedItem="{Binding SelectedRepositoryPath}"
                              FontSize="12" Height="26"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,2,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding, Converter={StaticResource PathToNameConverter}}" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Branch Selector -->
                    <ComboBox Grid.Column="1"
                              SelectedIndex="0"
                              FontSize="12" Height="26"
                              HorizontalAlignment="Stretch"
                              Margin="2,0,0,0">
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Data="M13,8.5C13,9.7 12.3,10.8 11.3,11.3V12.7C12.3,13.2 13,14.3 13,15.5C13,17.4 11.4,19 9.5,19C7.6,19 6,17.4 6,15.5C6,14.3 6.7,13.2 7.7,12.7V11.3C6.7,10.8 6,9.7 6,8.5C6,6.6 7.6,5 9.5,5C11.4,5 13,6.6 13,8.5Z"
                                      Fill="#61AFEF" Width="9" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentBranch}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>

            </DockPanel>
        </Border>

        <!-- ══ Row 1: Sync status + View all commits + Branch icon ══ -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <!-- Branch icon (right) -->
                <Button DockPanel.Dock="Right"
                        Background="Transparent" BorderThickness="0" Padding="4"
                        ToolTip.Tip="Manage Branches">
                    <Path Data="M17,17.5A2.5,2.5 0 0,1 14.5,20A2.5,2.5 0 0,1 12,17.5C12,16.5 12.58,15.65 13.4,15.22V8.78C12.58,8.35 12,7.5 12,6.5A2.5,2.5 0 0,1 14.5,4A2.5,2.5 0 0,1 17,6.5C17,7.5 16.42,8.35 15.6,8.78V15.22C16.42,15.65 17,16.5 17,17.5M9,17.5A2.5,2.5 0 0,1 6.5,20A2.5,2.5 0 0,1 4,17.5C4,16.5 4.58,15.65 5.4,15.22V6.5A2.5,2.5 0 0,1 7.9,4C8.61,4 9.25,4.29 9.7,4.76C9.28,5.2 9,5.82 9,6.5C9,7.66 9.79,8.64 10.87,8.92C10.42,9.37 10.05,9.89 9.8,10.46C9.29,9.58 8.6,8.81 7.79,8.18C8.23,7.74 8.5,7.15 8.5,6.5A2,2 0 0,0 6.5,4.5A2,2 0 0,0 4.5,6.5A2,2 0 0,0 6.5,8.5C6.96,8.5 7.39,8.34 7.72,8.08C8.59,8.79 9.35,9.66 9.94,10.66C10.53,11.66 10.95,12.75 11.2,13.88C10.5,14.36 10,15.17 10,16.08C10,16.63 10.15,17.15 10.43,17.58C9.97,17.79 9.49,17.9 9,17.9V17.5M14.5,5A1.5,1.5 0 0,0 13,6.5A1.5,1.5 0 0,0 14.5,8A1.5,1.5 0 0,0 16,6.5A1.5,1.5 0 0,0 14.5,5M14.5,16A1.5,1.5 0 0,0 13,17.5A1.5,1.5 0 0,0 14.5,19A1.5,1.5 0 0,0 16,17.5A1.5,1.5 0 0,0 14.5,16Z"
                          Fill="{DynamicResource ThemeForegroundLowBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <!-- ↑↓ 0/0  View all commits -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               VerticalAlignment="Center">
                        <Run Text="↑↓"/>
                        <Run Text="{Binding CommitsCount}"/>
                        <Run Text="/ 0"/>
                    </TextBlock>
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding ViewAllCommitsCommand}"
                            VerticalAlignment="Center">
                        <TextBlock Text="View all commits" FontSize="12"
                                   Foreground="#0078D4" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Row 2: Commit message ══ -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1" Padding="8,8">
            <Grid RowDefinitions="*,Auto">
                <!-- Message TextBox -->
                <TextBox Grid.Row="0"
                         Text="{Binding CommitMessage}"
                         Watermark="Enter a message &lt;Required&gt;"
                         AcceptsReturn="True"
                         MinHeight="60" MaxHeight="120"
                         FontSize="12"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                         Background="{DynamicResource ThemeControlLowBrush}"
                         CornerRadius="4,4,0,0"
                         Padding="8,6"/>

                <!-- Bottom toolbar of message box -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ThemeControlLowBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,4,4"
                        Padding="4,3">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                        <!-- AI / Copilot icon -->
                        <Button Background="Transparent" BorderThickness="0" Padding="4"
                                ToolTip.Tip="Generate commit message with AI">
                            <Path Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21A7,7 0 0,1 14,26H10A7,7 0 0,1 3,19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"
                                  Fill="{DynamicResource ThemeForegroundLowBrush}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <!-- Add work item (#) -->
                        <Button Background="Transparent" BorderThickness="0" Padding="4"
                                ToolTip.Tip="Add work item reference">
                            <TextBlock Text="#" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Row 3: Commit All split button + Amend ══ -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <!-- Commit All split button -->
                <Grid DockPanel.Dock="Left" ColumnDefinitions="*,1,Auto">
                    <Button Grid.Column="0"
                            Content="Commit All"
                            Height="28" Padding="12,0" FontSize="12"
                            Command="{Binding CommitAsync}"
                            Classes="accent"
                            IsEnabled="{Binding !!CommitMessage.Length}"/>
                    <Rectangle Grid.Column="1" Fill="#FFFFFF" Opacity="0.25"/>
                    <Button Grid.Column="2" Height="28" Width="26" Padding="3"
                            Classes="accent"
                            ToolTip.Tip="Commit options">
                        <Path Data="M7,10L12,15L17,10H7Z"
                              Fill="White" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Amend checkbox -->
                <CheckBox DockPanel.Dock="Left"
                          Content="Amend"
                          FontSize="12" Margin="12,0,0,0"
                          VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ══ Row 4: Changes tree ══ -->
        <ScrollViewer Grid.Row="4">
            <StackPanel>

                <!-- Changes section header -->
                <Border Background="{DynamicResource ThemeControlLowBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="0,0,0,1" Padding="8,5">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Path Data="M7,10L12,15L17,10H7Z"
                                  Fill="{DynamicResource ThemeForegroundLowBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeForegroundBrush}"
                                       VerticalAlignment="Center">
                                <Run Text="Changes ("/>
                                <Run Text="{Binding LocalChanges.Count}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- Stage all / Undo all / More -->
                        <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Right">
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    ToolTip.Tip="Stage All" Command="{Binding SelectAllAsync}">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Fill="Gray" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    ToolTip.Tip="Undo All Changes" Command="{Binding RollbackAllAsync}">
                                <Path Data="M19,13H5V11H19V13Z"
                                      Fill="Gray" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    ToolTip.Tip="More">
                                <Path Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"
                                      Fill="Gray" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8" Margin="0,30,0,0"
                            IsVisible="{Binding !LocalChanges.Count}">
                    <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                          Fill="#5DA656" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="No local changes" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Files tree -->
                <TreeView ItemsSource="{Binding ChangesTree}"
                          Background="Transparent" BorderThickness="0"
                          IsVisible="{Binding !!LocalChanges.Count}"
                          SelectionChanged="OnTreeSelectionChanged">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:GitChangeNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                          x:DataType="vm:GitChangeNode">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rollback"
                                                  Command="{Binding $parent[UserControl].((vm:GitChangesViewModel)DataContext).RollbackAsync}"
                                                  CommandParameter="{Binding Change}"
                                                  IsVisible="{Binding !IsFolder}"/>
                                        <MenuItem Header="Show Diff"
                                                  Command="{Binding $parent[UserControl].((vm:GitChangesViewModel)DataContext).ShowDiffAsync}"
                                                  CommandParameter="{Binding Change}"
                                                  IsVisible="{Binding !IsFolder}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <!-- Folder icon -->
                                <Path Grid.Column="0"
                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                      Fill="#E5C07B" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,5,0"
                                      IsVisible="{Binding IsFolder}"/>
                                <!-- File icon -->
                                <Path Grid.Column="0"
                                      Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"
                                      Fill="{Binding Status, Converter={StaticResource GitStatusForegroundConverter}}"
                                      Width="12" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,5,0"
                                      IsVisible="{Binding !IsFolder}"/>
                                <!-- Name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeForegroundBrush}"
                                           ToolTip.Tip="{Binding FullPath}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Status letter badge -->
                                <Border Grid.Column="2"
                                        Margin="4,0,4,0"
                                        IsVisible="{Binding !IsFolder}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource GitStatusForegroundConverter}}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Row 5: Stashes (collapsible) ══ -->
        <Border Grid.Row="5"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Stashes" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Background="#0078D4" CornerRadius="8" Padding="5,0"
                                IsVisible="{Binding !!StashCount}">
                            <TextBlock Text="{Binding StashCount}" FontSize="9" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Expander.Header>
                <StackPanel>
                    <ListBox ItemsSource="{Binding Stashes}"
                             SelectedItem="{Binding SelectedStash}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="150">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GitStashEntry">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Index}" FontSize="10"
                                               Foreground="#0078D4" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Message}" FontSize="12"
                                               Foreground="{DynamicResource ThemeForegroundBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Stash actions -->
                    <Border Padding="8,6"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding SelectedStash, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Pop"   Command="{Binding StashPopAsync}"   Height="24" Padding="10,0" FontSize="11"/>
                            <Button Content="Apply" Command="{Binding StashApplyAsync}" Height="24" Padding="10,0" FontSize="11"/>
                            <Button Content="Drop"  Command="{Binding StashDropAsync}"  Height="24" Padding="10,0" FontSize="11" Foreground="#E06C75"/>
                        </StackPanel>
                    </Border>
                    <!-- New stash -->
                    <Border Padding="8,6">
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Grid.Column="0" Text="{Binding StashMessage}"
                                     Watermark="Stash message..." FontSize="11" Height="26"/>
                            <Button Grid.Column="2" Content="Stash" Height="26" Padding="10,0"
                                    FontSize="11" Command="{Binding StashAsync}" Classes="accent"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="#15000000"
                IsVisible="{Binding IsBusy}"
                IsHitTestVisible="False">
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2"/>
        </Border>

    </Grid>
</UserControl>
