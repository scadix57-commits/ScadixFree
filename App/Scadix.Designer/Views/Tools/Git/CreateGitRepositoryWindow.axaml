<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scadix.Designer.ViewModels"
        x:Class="Scadix.Designer.Views.Tools.Git.CreateGitRepositoryWindow"
        x:DataType="vm:CreateGitRepositoryViewModel"
        Title="Create a Git repository"
        Width="850" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#FBFBFB"
        TransparencyLevelHint="None"
        ExtendClientAreaToDecorationsHint="False">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style Selector="Button.sidebar-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button.sidebar-btn:pointerover">
            <Setter Property="Background" Value="#E5E5E5"/>
        </Style>
        <Style Selector="Button.sidebar-btn.selected">
            <Setter Property="Background" Value="#DEE6F7"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#F3F3F3">
            <StackPanel Margin="0,20,0,0" Spacing="4">
                <TextBlock Text="Push to a new remote" Margin="15,0,0,10" Foreground="#666666" FontSize="11" FontWeight="SemiBold"/>
                
                <Button Classes="sidebar-btn"
                        Command="{Binding SetGitHubCommand}"
                        Classes.selected="{Binding !IsLocalOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M12,2C6.47,2 2,6.47 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21.03C9.5,20.81 9.5,20.24 9.5,19.47C6.73,20.07 6.14,18.14 6.14,18.14C5.69,17 5.05,16.7 5.05,16.7C4.14,16.08 5.12,16.1 5.12,16.1C6.12,16.17 6.65,17.12 6.65,17.12C7.54,18.65 9,18.21 9.56,17.96C9.65,17.31 9.91,16.87 10.2,16.62C7.97,16.37 5.62,15.5 5.62,11.66C5.62,10.56 6,9.67 6.63,8.97C6.53,8.71 6.18,7.69 6.73,6.31C6.73,6.31 7.57,6.04 9.47,7.32C10.27,7.1 11.12,7 12,7C12.88,7 13.73,7.1 14.53,7.32C16.43,6.04 17.27,6.31 17.27,6.31C17.82,7.69 17.47,8.71 17.37,8.97C18,9.67 18.38,10.56 18.38,11.66C18.38,15.51 16.03,16.37 13.8,16.61C14.16,16.92 14.48,17.54 14.48,18.47C14.48,19.8 14.47,20.87 14.47,21.19C14.47,21.44 14.63,21.73 15.14,21.63C19.13,20.3 22,16.55 22,12C22,6.47 17.53,2 12,2Z" 
                              Fill="#24292E" Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M2,2H22V22H2V2M4,4V20H20V4H4M6,6H18V8H6V6M6,10H18V12H6V10M6,14H14V16H6V14Z" 
                              Fill="#0078D4" Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="Azure DevOps" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar-btn" 
                        Command="{Binding SetLocalOnlyCommand}"
                        Classes.selected="{Binding IsLocalOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" 
                              Fill="#666666" Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="Local only" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar-btn">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" 
                              Fill="#666666" Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="Existing remote" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto" Margin="30">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Create a Git repository" Classes="header" Margin="0,0,0,30"/>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="25">
                    
                    <!-- Section 1: Repository settings -->
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M4,10C4,10 4,4 12,4C20,4 20,10 20,10M4,10C4,10 4,16 12,16C20,16 20,10 20,10M12,4V16" 
                                  Fill="#E44D26" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Local Git repository" Classes="section-header" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120, *, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Local path" Classes="label" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LocalPath}" IsReadOnly="True" Margin="0,0,0,10"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="..." Width="32" Height="32" Margin="5,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="License template" Classes="label"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LicenseTemplates}" SelectedItem="{Binding LicenseTemplate}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Section 2: Create a new GitHub repository -->
                    <StackPanel Spacing="15" IsVisible="{Binding !IsLocalOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12,2C6.47,2 2,6.47 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21.03C9.5,20.81 9.5,20.24 9.5,19.47C6.73,20.07 6.14,18.14 6.14,18.14C5.69,17 5.05,16.7 5.05,16.7C4.14,16.08 5.12,16.1 5.12,16.1C6.12,16.17 6.65,17.12 6.65,17.12C7.54,18.65 9,18.21 9.56,17.96C9.65,17.31 9.91,16.87 10.2,16.62C7.97,16.37 5.62,15.5 5.62,11.66C5.62,10.56 6,9.67 6.63,8.97C6.53,8.71 6.18,7.69 6.73,6.31C6.73,6.31 7.57,6.04 9.47,7.32C10.27,7.1 11.12,7 12,7C12.88,7 13.73,7.1 14.53,7.32C16.43,6.04 17.27,6.31 17.27,6.31C17.82,7.69 17.47,8.71 17.37,8.97C18,9.67 18.38,10.56 18.38,11.66C18.38,15.51 16.03,16.37 13.8,16.61C14.16,16.92 14.48,17.54 14.48,18.47C14.48,19.8 14.47,20.87 14.47,21.19C14.47,21.44 14.63,21.73 15.14,21.63C19.13,20.3 22,16.55 22,12C22,6.47 17.53,2 12,2Z" 
                                  Fill="#24292E" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Create a new GitHub repository" Classes="section-header" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Classes="label" Margin="0,0,0,10"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                <TextBox Text="{Binding Account}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Change..." Command="{Binding SelectAccountCommand}" Margin="5,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner" Classes="label" Margin="0,0,0,10"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Owners}" SelectedItem="{Binding Owner}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Repository name" Classes="label" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepositoryName}" Watermark="Enter the name of the GitHub repository" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description" Classes="label" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Description}" Watermark="Enter the description of the GitHub repository &lt;Optional&gt;" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Visibility" Classes="label"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding Visibility}"/>
                                <TextBlock Text="You choose who can see and commit to this repository." FontSize="11" Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Section 3: Remote info -->
                    <StackPanel Spacing="15" IsVisible="{Binding !IsLocalOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z" 
                                  Fill="#666666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Repository info" Classes="section-header" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RemoteUrl}" Margin="28,0,0,0" Foreground="#005A9E" FontSize="12"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Content="Create" Command="{Binding CreateCommand}" Width="80" Classes="accent" IsEnabled="{Binding !IsBusy}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>

            <!-- Progress info -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0" IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Height="4"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#666666" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
