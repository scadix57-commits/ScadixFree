<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			   xmlns:Hmi="clr-namespace:HMIControl.HMI.Themes;assembly=HMIControl.HMI"
             xmlns:core="clr-namespace:HMIControl.Core.Themes;assembly=HMIControl.Core"
             xmlns:local="clr-namespace:TemplateProjectName"
             x:Class="TemplateProjectName.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
				
				 <core:Generic />
                <Hmi:Generic />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
