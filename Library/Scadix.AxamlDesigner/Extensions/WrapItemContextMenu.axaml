<ContextMenu x:Class="Scadix.AxamlDesigner.Extensions.WrapItemContextMenu"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Translation="clr-namespace:Scadix.AxamlDesigner">
    <MenuItem Header="{Binding WrapInViewbox, Source={x:Static Translation:Translations.Instance}}" Click="Click_WrapInViewbox">
        <MenuItem.Icon>
            <Image Source="avares://Scadix.AxamlDesigner/Images/wrap-option.png" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
