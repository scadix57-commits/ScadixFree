<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Scadix.AxamlDesigner.Controls.Thumbs"
    xmlns:controls="clr-namespace:Scadix.AxamlDesigner.Controls"
    xmlns:designer="clr-namespace:Scadix.AxamlDesigner"
    xmlns:formatedTextEditor="clr-namespace:Scadix.AxamlDesigner.PropertyGrid.Editors.FormatedTextEditor">
    <!--  Avalonia 12 converted styles  -->
    <!--
        This file contains the default styles used by the Controls in Scadix.AxamlDesigner.Controls
    -->
    <designer:LevelConverter x:Key="FormatDoubleConverter" />
    <controls:HandleLengthWithOffset x:Key="HandleLengthWithOffset" />
    <SolidColorBrush x:Key="HandleBrush" Color="#FF474747" />

    <!--  PanelMoveAdorner  -->

    <ControlTheme x:Key="{x:Type controls:PanelMoveAdorner}" TargetType="controls:PanelMoveAdorner">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:PanelMoveAdorner">
                <Border
                    Margin="-2"
                    BorderBrush="Transparent"
                    BorderThickness="4"
                    Cursor="SizeAll" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  EnumButton  -->

    <ControlTheme
        x:Key="{x:Type controls:EnumButton}"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="controls:EnumButton">
        <Setter Property="Margin" Value="3,3,0,3" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleButton">
                <Grid>
                    <Border
                        x:Name="Background"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border
                                x:Name="BackgroundAnimation"
                                Background="#FF448DCA"
                                Opacity="0" />
                        </Grid>
                    </Border>
                    <ContentPresenter
                        x:Name="contentPresenter"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="SkyBlue" />
        </Style>
    </ControlTheme>

    <!--  DesignerThumb  -->

    <ControlTheme x:Key="{x:Type Controls:DesignerThumb}" TargetType="Controls:DesignerThumb">
        <Setter Property="Template">
            <ControlTemplate TargetType="Controls:DesignerThumb">
                <Grid>
                    <Rectangle
                        Name="thumbRectangle"
                        Fill="White"
                        RadiusX="1.414"
                        RadiusY="1.414"
                        Stroke="Black" />
                    <Menu
                        Width="15"
                        Height="15"
                        Margin="0,-19,-19,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        IsVisible="{Binding Path=OperationMenu, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static designer:CollapsedWhenNull.Instance}}">
                        <MenuItem
                            Width="15"
                            Height="15"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="1"
                            ItemsSource="{TemplateBinding OperationMenu}">
                            <MenuItem.Header>
                                <Path
                                    Data="M3.5,5.5 L11.5,5.5 L7.5,11 z"
                                    Fill="Black"
                                    Stroke="Gray"
                                    StrokeThickness="1" />
                            </MenuItem.Header>
                        </MenuItem>
                    </Menu>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsPrimarySelection=False] /template/ Rectangle#thumbRectangle">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="Fill" Value="Black" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#thumbRectangle">
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style Selector="^[ThumbVisible=False] /template/ Rectangle#thumbRectangle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!--  PointThumb  -->

    <ControlTheme x:Key="{x:Type Controls:PointThumb}" TargetType="Controls:PointThumb">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Controls:PointThumb">
                <Grid
                    Margin="-3.5,-3.5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid.Resources>
                        <designer:DoubleOffsetConverter x:Key="PointOffset" Offset="3.5" />
                    </Grid.Resources>
                    <Path
                        IsVisible="{Binding RelativeToPoint, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static designer:CollapsedWhenNull.Instance}}"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeDashArray="2,2"
                        StrokeThickness="1">
                        <Path.Data>
                            <LineGeometry StartPoint="3.5,3.5">
                                <LineGeometry.EndPoint>
                                    <MultiBinding Converter="{StaticResource designer:PointMultiConverter}">
                                        <Binding Path="RelativeToPoint.X" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="RelativeToPoint.Y" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </LineGeometry.EndPoint>
                            </LineGeometry>
                        </Path.Data>
                    </Path>
                    <Grid
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Grid.Styles>
                            <Style Selector="MenuItem">
                                <!--<Setter Property="Padding" Value="2,0" />-->
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Styles>
                        <Rectangle
                            Name="thumbRectangle"
                            Width="7"
                            Height="7"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="White"
                            RadiusX="1.414"
                            RadiusY="1.414"
                            Stroke="{TemplateBinding Foreground}"
                            UseLayoutRounding="True" />
                        <Ellipse
                            Name="thumbElipse"
                            Width="7"
                            Height="7"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="White"
                            IsVisible="False"
                            Stroke="{TemplateBinding Foreground}"
                            UseLayoutRounding="True" />
                        <Menu
                            Width="15"
                            Height="15"
                            Margin="0,-19,-19,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="Black"
                            IsVisible="{Binding Path=OperationMenu, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static designer:CollapsedWhenNull.Instance}}">
                            <MenuItem
                                Width="15"
                                Height="15"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="1"
                                ItemsSource="{TemplateBinding OperationMenu}"
                                RenderTransform="{TemplateBinding InnerRenderTransform}">
                                <MenuItem.Header>
                                    <Path
                                        Data="M3.5,5.5 L11.5,5.5 L7.5,11 z"
                                        Fill="Black"
                                        Stroke="Gray"
                                        StrokeThickness="1" />
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsPrimarySelection=False] /template/ Rectangle#thumbRectangle">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="Fill" Value="Black" />
        </Style>
        <Style Selector="^[IsPrimarySelection=False] /template/ Ellipse#thumbElipse">
            <Setter Property="Fill" Value="Black" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#thumbRectangle">
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style Selector="^[IsEllipse=True] /template/ Rectangle#thumbRectangle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[IsEllipse=True] /template/ Ellipse#thumbElipse">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[ThumbVisible=False] /template/ Rectangle#thumbRectangle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[ThumbVisible=False] /template/ Ellipse#thumbElipse">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!--  RotateThumb  -->

    <ControlTheme x:Key="{x:Type Controls:RotateThumb}" TargetType="Controls:RotateThumb">
        <Setter Property="Template">
            <ControlTemplate TargetType="Controls:RotateThumb">
                <Grid>
                    <Rectangle
                        Width="2"
                        Height="30"
                        Margin="0,0,0,0"
                        VerticalAlignment="Top"
                        Fill="Black" />
                    <Ellipse
                        Name="thumbRectangle"
                        Width="7"
                        Height="7"
                        VerticalAlignment="Top"
                        Fill="Black"
                        Stroke="Black"
                        StrokeThickness="1"
                        UseLayoutRounding="True" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  SelectionFrame  -->

    <ControlTheme x:Key="{x:Type controls:SelectionFrame}" TargetType="controls:SelectionFrame">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:SelectionFrame">
                <Rectangle
                    Fill="#519ABFE5"
                    Stroke="#FF7A8787"
                    StrokeThickness="1" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  ContainerDragHandle  -->

    <ControlTheme x:Key="{x:Type controls:ContainerDragHandle}" TargetType="controls:ContainerDragHandle">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ContainerDragHandle">
                <Canvas
                    Name="Canvas"
                    Width="13"
                    Height="13"
                    UseLayoutRounding="True">
                    <Rectangle
                        Name="BorderRectangle"
                        Width="13"
                        Height="13"
                        Fill="#889ABFE5"
                        RadiusX="2"
                        RadiusY="2"
                        Stroke="#FF7A8FB5"
                        StrokeThickness="1" />
                    <Path
                        Canvas.Left="1"
                        Canvas.Top="1"
                        Fill="#FF748EAA">
                        <Path.Data>
                            <GeometryGroup>
                                <PathGeometry Figures="M5.5,0L3,3L8,3 M11,5.5L8,3L8,8 M5.5,11L3,8L8,8 M0,5.5L3,3L3,8" />
                                <RectangleGeometry Rect="3,5,5,1" />
                                <RectangleGeometry Rect="5,3,1,5" />
                                <RectangleGeometry Rect="5,5,1,1" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  WindowClone  -->

    <ControlTheme x:Key="{x:Type controls:WindowClone}" TargetType="controls:WindowClone">
        <Setter Property="Width" Value="640" />
        <Setter Property="Height" Value="480" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:WindowClone">
                <Border
                    Background="#FFB9D1EA"
                    BorderBrush="#FF646464"
                    BorderThickness="1,1,1,1">
                    <DockPanel Margin="4,0,4,4">
                        <DockPanel Height="26" DockPanel.Dock="Top">
                            <Image
                                Width="20"
                                Height="20"
                                Margin="1,0,0,0"
                                IsVisible="{Binding Path=Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static designer:CollapsedWhenNotNull.Instance}}"
                                Source="avares://Scadix.AxamlDesigner/Images/Icons.32x32.EmptyProjectIcon.png" />
                            <Image
                                Width="20"
                                Height="20"
                                Margin="1,0,0,0"
                                IsVisible="{Binding Path=Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static designer:CollapsedWhenZero.Instance}}"
                                Source="{Binding Path=Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button
                                Name="CloseButton"
                                Width="43"
                                Height="17"
                                VerticalAlignment="Top"
                                Content="r"
                                DockPanel.Dock="Right"
                                FontFamily="Marlett" />
                            <Button
                                Name="MinimizeButton"
                                Width="25"
                                Height="17"
                                VerticalAlignment="Top"
                                Content="1"
                                DockPanel.Dock="Right"
                                FontFamily="Marlett"
                                IsVisible="{Binding Path=CanResize, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static designer:EnumCollapsed.Instance}, ConverterParameter=NoResize}" />
                            <Button
                                Name="MaximiseButton"
                                Width="25"
                                Height="17"
                                VerticalAlignment="Top"
                                Content="0"
                                DockPanel.Dock="Right"
                                FontFamily="Marlett"
                                IsVisible="{Binding Path=CanResize, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static designer:EnumCollapsed.Instance}, ConverterParameter=NoResize}" />
                            <Label Margin="4,0,0,0" Content="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DockPanel>
                        <Border Background="#FFFFFFFF">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClipToBounds="True">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True">
                                    <VisualLayerManager>
                                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
                                    </VisualLayerManager>
                                </Border>
                            </Border>
                        </Border>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  ErrorBalloon  -->

    <ControlTheme x:Key="{x:Type controls:ErrorBalloon}" TargetType="controls:ErrorBalloon">

        <Setter Property="SystemDecorations" Value="None" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />

        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ErrorBalloon">
                <Grid x:Name="LayoutRoot">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Margin="12,36,4,4"
                        RadiusX="10"
                        RadiusY="10">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="#41626262" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border
                        Margin="8,32,8,8"
                        Padding="10,10,10,10"
                        Background="#FFFFFFE1"
                        BorderBrush="#FF646464"
                        BorderThickness="1,1,1,1"
                        CornerRadius="10,10,10,10">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <VisualLayerManager>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </VisualLayerManager>
                        </Border>
                    </Border>
                    <Path
                        Width="15.25"
                        Height="24.5"
                        Margin="34.75,9.25,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Data="M34.75,33.75 L40.5,9.25 50,33.5 z"
                        Fill="#FFFFFFE1"
                        Stretch="Fill" />
                    <Path
                        Width="16"
                        Height="24"
                        Margin="34.5,9.25,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Data="M35,32.75 L40.5,9.25 50,32.75"
                        Stretch="Fill"
                        Stroke="#FF646464" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  GridRowSplitterAdorner  -->

    <ControlTheme x:Key="{x:Type controls:GridRowSplitterAdorner}" TargetType="controls:GridRowSplitterAdorner">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:GridRowSplitterAdorner">
                <Grid Height="{x:Static controls:GridRailAdorner.SplitterWidth}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <!--  10=RailSize  -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  put a transparent rectangle in the rail so the user does not have to hit the small railHandle  -->
                    <Rectangle Fill="Transparent" />
                    <Path
                        Name="railHandle"
                        Data="M0,0 L0,1 1,0.5 z"
                        Fill="#FFE6E6FF"
                        Stretch="Fill"
                        Stroke="DodgerBlue"
                        StrokeThickness="1" />
                    <Path
                        Name="line"
                        Grid.Column="2"
                        Margin="-1,0,0,0"
                        Data="M0,0.5 L1,0.5"
                        Stretch="Fill"
                        Stroke="DodgerBlue"
                        StrokeThickness="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#railHandle">
            <Setter Property="Fill" Value="#FFFFB74F" />
        </Style>
        <Style Selector="^[IsPreview=True] /template/ Path#railHandle">
            <Setter Property="Stroke" Value="#D0FFB74F" />
        </Style>
        <Style Selector="^[IsPreview=True] /template/ Path#line">
            <Setter Property="Stroke" Value="#D0FFB74F" />
        </Style>
    </ControlTheme>

    <!--  GridColumnSplitterAdorner  -->

    <ControlTheme x:Key="{x:Type controls:GridColumnSplitterAdorner}" TargetType="controls:GridColumnSplitterAdorner">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:GridColumnSplitterAdorner">
                <Grid Width="{x:Static controls:GridRailAdorner.SplitterWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <!--  10=RailSize  -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  put a transparent rectangle in the rail so the user does not have to hit the small railHandle  -->
                    <Rectangle Fill="Transparent" />
                    <Path
                        Name="railHandle"
                        Data="M0,0 L1,0 0.5,1 z"
                        Fill="#FFE6E6FF"
                        Stretch="Fill"
                        Stroke="DodgerBlue"
                        StrokeThickness="1" />
                    <Path
                        Name="line"
                        Grid.Row="2"
                        Margin="0,-1,0,0"
                        Data="M0.5,0 L0.5,1"
                        Stretch="Fill"
                        Stroke="DodgerBlue"
                        StrokeThickness="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#railHandle">
            <Setter Property="Fill" Value="#FFFFB74F" />
        </Style>
        <Style Selector="^[IsPreview=True] /template/ Path#railHandle">
            <Setter Property="Stroke" Value="#D0FFB74F" />
        </Style>
        <Style Selector="^[IsPreview=True] /template/ Path#line">
            <Setter Property="Stroke" Value="#D0FFB74F" />
        </Style>
    </ControlTheme>

    <!--  CanvasPositionHandle  -->

    <ControlTheme x:Key="{x:Type controls:CanvasPositionHandle}" TargetType="controls:CanvasPositionHandle">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:CanvasPositionHandle">
                <LayoutTransformControl Name="layoutTransform2">
                    <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="{Binding Path=Angle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                    </LayoutTransformControl.LayoutTransform>
                    <Grid
                        Width="{Binding Path=HandleLength, Converter={x:Static controls:HandleLengthWithOffset.Instance}, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        Height="10"
                        UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Name="startArrow"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Data="M0,0 L0,1 1,0.5 z"
                            Fill="{StaticResource HandleBrush}"
                            Stretch="Fill"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="0.5" />
                        <!--  Wrap the handle-line and endArrow in this grid. It's visiblity is subjected to HandleLength  -->
                        <Grid
                            Name="lineArrow"
                            Grid.Column="1"
                            Height="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition
                                    MinWidth="10"
                                    MaxWidth="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Height="10"
                                Fill="Transparent" />
                            <Path
                                Name="line1"
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                Data="M0,-0.75 L1,-0.75"
                                Stretch="Fill"
                                Stroke="{StaticResource HandleBrush}"
                                StrokeDashArray="2,2"
                                StrokeThickness="1.5" />
                            <LayoutTransformControl Grid.Column="1" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="{Binding Path=TextTransform, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock
                                    Padding="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Text="{Binding Path=HandleLength, Mode=OneWay, Converter={x:Static designer:FormatDoubleConverter.Instance}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            </LayoutTransformControl>

                            <Path
                                Name="line2"
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                Data="M0,-0.75 L1,-0.75"
                                Stretch="Fill"
                                Stroke="{StaticResource HandleBrush}"
                                StrokeDashArray="2,2"
                                StrokeThickness="1.5" />
                            <!--<Path Name="arrow2" Margin="0,1,0,1" Fill="{StaticResource HandleBrush}" Stretch="Fill" Stroke="{TemplateBinding Background}" StrokeThickness="0.5" Data="M0,0 L0,1 1,0.5 z" Grid.Column="3" />-->
                            <!--<Rectangle Width="1.5" Fill="{StaticResource HandleBrush}" Grid.Column="4"/>-->
                        </Grid>
                    </Grid>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  MarginHandle  -->

    <ControlTheme x:Key="{x:Type controls:MarginHandle}" TargetType="controls:MarginHandle">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MarginHandle">
                <LayoutTransformControl Name="layoutTransform2">
                    <LayoutTransformControl.LayoutTransform>
                        <RotateTransform Angle="{Binding Path=Angle, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                    </LayoutTransformControl.LayoutTransform>
                    <Grid
                        Width="{Binding Path=HandleLength, Converter={x:Static controls:HandleLengthWithOffset.Instance}, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        Height="10"
                        UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Name="startArrow"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Data="M0,0 L0,1 1,0.5 z"
                            Fill="{StaticResource HandleBrush}"
                            Stretch="Fill"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="0.5" />
                        <!--  Wrap the handle-line and endArrow in this grid. It's visiblity is subjected to HandleLength  -->
                        <Grid
                            Name="lineArrow"
                            Grid.Column="1"
                            Height="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition
                                    MinWidth="10"
                                    MaxWidth="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.5" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Height="10"
                                Fill="Transparent" />
                            <Path
                                Name="line1"
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                Data="M0,-0.75 L1,-0.75"
                                Stretch="Fill"
                                Stroke="{StaticResource HandleBrush}"
                                StrokeThickness="1.5" />
                            <LayoutTransformControl Grid.Column="1" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="{Binding Path=TextTransform, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock
                                    Padding="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Text="{Binding Path=HandleLength, Mode=OneWay, Converter={x:Static designer:FormatDoubleConverter.Instance}, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                            </LayoutTransformControl>

                            <Path
                                Name="line2"
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                Data="M0,-0.75 L1,-0.75"
                                Stretch="Fill"
                                Stroke="{StaticResource HandleBrush}"
                                StrokeThickness="1.5" />
                            <Path
                                Name="arrow2"
                                Grid.Column="3"
                                Margin="0,1,0,1"
                                Data="M0,0 L0,1 1,0.5 z"
                                Fill="{StaticResource HandleBrush}"
                                Stretch="Fill"
                                Stroke="{TemplateBinding Background}"
                                StrokeThickness="0.5" />
                            <Rectangle
                                Grid.Column="4"
                                Width="1.5"
                                Fill="{StaticResource HandleBrush}" />
                        </Grid>
                    </Grid>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  MarginStub  -->


    <ControlTheme x:Key="{x:Type controls:MarginStub}" TargetType="controls:MarginStub">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MarginStub">
                <Grid
                    Width="10"
                    Height="10"
                    UseLayoutRounding="True">
                    <Rectangle Fill="Transparent" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="{TemplateBinding Background}"
                        Stroke="{StaticResource HandleBrush}"
                        StrokeThickness="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  HeightDisplay  -->

    <ControlTheme x:Key="{x:Type controls:HeightDisplay}" TargetType="controls:HeightDisplay">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:HeightDisplay">
                <Grid Width="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition MinHeight="5" MaxHeight="20" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Path
                        Grid.Row="0"
                        Data="M0,0 L1,0 M0.75,0 L0.75,1"
                        Stretch="Fill"
                        Stroke="#AC0000"
                        StrokeThickness="1.0"
                        UseLayoutRounding="True" />
                    <LayoutTransformControl Grid.Row="1" HorizontalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <RotateTransform Angle="270" />
                        </LayoutTransformControl.LayoutTransform>
                        <TextBlock
                            Margin="0,0,0,8"
                            Padding="1"
                            FontSize="10">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static designer:ControlToRealHeightConverter.Instance}">
                                    <Binding />
                                    <Binding Path="Bounds" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </LayoutTransformControl>
                    <Path
                        Grid.Row="2"
                        Data="M0.75,0 L0.75,3 M0,3 L1,3 "
                        Stretch="Fill"
                        Stroke="#AC0000"
                        StrokeThickness="1.0"
                        UseLayoutRounding="True" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  WidthDisplay  -->

    <ControlTheme x:Key="{x:Type controls:WidthDisplay}" TargetType="controls:WidthDisplay">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:WidthDisplay">
                <Grid Height="22" UseLayoutRounding="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition MinWidth="5" MaxWidth="20" />
                        <ColumnDefinition Width="5" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Grid.Column="0"
                        Data="M0,0 L0,1 M0,0.75 L1,0.75"
                        Stretch="Fill"
                        Stroke="#AC0000"
                        StrokeThickness="1"
                        UseLayoutRounding="True" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Padding="1"
                        HorizontalAlignment="Center"
                        FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static designer:ControlToRealWidthConverter.Instance}">
                                <Binding />
                                <Binding Path="Bounds" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Path
                        Grid.Column="2"
                        Data="M0,0.75 L3,0.75 M3,0 L3,1 "
                        Stretch="Fill"
                        Stroke="#AC0000"
                        StrokeThickness="1"
                        UseLayoutRounding="True" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  InPlaceEditor  -->

    <ControlTheme x:Key="{x:Type controls:InPlaceEditor}" TargetType="controls:InPlaceEditor">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:InPlaceEditor">
                <Grid Margin="-2,1,-10,0">
                    <TextBox
                        Name="PART_Editor"
                        Padding="{TemplateBinding Padding}"
                        AcceptsReturn="True"
                        BorderThickness="0"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontStretch="{TemplateBinding FontStretch}"
                        FontStyle="{TemplateBinding FontStyle}"
                        FontWeight="{TemplateBinding FontWeight}"
                        UseLayoutRounding="True" />
                    <formatedTextEditor:RichTextBoxToolbar
                        x:Name="PART_Toolbar"
                        Margin="0,-50,-160,0"
                        RichTextBox="{Binding ElementName=PART_Editor}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  QuickOperationMenu  -->

    <ControlTheme x:Key="{x:Type controls:QuickOperationMenu}" TargetType="controls:QuickOperationMenu">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:QuickOperationMenu">
                <Menu
                    Name="menu1"
                    Width="15"
                    Height="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0">
                    <MenuItem
                        Name="MainHeader"
                        Width="15"
                        Height="15"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="1">
                        <MenuItem.Header>
                            <Path
                                Data="M3.5,5.5 L11.5,5.5 L7.5,11 z"
                                Fill="Black"
                                Stroke="Gray"
                                StrokeThickness="1" />
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  ZoomControl  -->

    <ControlTheme x:Key="{x:Type controls:ZoomControl}" TargetType="controls:ZoomControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ZoomControl">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:SelfCollapsingPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        CanCollapse="{Binding Path=ComputedZoomButtonCollapsed, Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                        CollapseOrientation="Horizontal">
                        <controls:ZoomButtons
                            x:Name="zoomButtons"
                            Maximum="{TemplateBinding MaximumZoom}"
                            Minimum="{TemplateBinding MinimumZoom}"
                            Value="{Binding Path=CurrentZoom, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                    </controls:SelfCollapsingPanel>
                    <Rectangle
                        Grid.Row="1"
                        Grid.Column="2"
                        Fill="#FFF0F0F0" />

                    <LayoutTransformControl
                        Name="layoutTransform"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3">

                        <ScrollContentPresenter
                            Name="PART_Presenter"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Path=CurrentZoom, RelativeSource={RelativeSource Mode=TemplatedParent}}" ScaleY="{Binding Path=CurrentZoom, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                        </LayoutTransformControl.LayoutTransform>
                    </LayoutTransformControl>



                    <ContentControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="{TemplateBinding AdditionalControls}" />
                    <ScrollBar
                        Name="PART_VerticalScrollBar"
                        Grid.Row="0"
                        Grid.Column="3"
                        Orientation="Vertical" />
                    <ScrollBar
                        Name="PART_HorizontalScrollBar"
                        Grid.Row="1"
                        Grid.Column="2"
                        Orientation="Horizontal" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  ClearButtonStyle  -->


    <ControlTheme x:Key="ClearButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFaaaaaa" />
        <Setter Property="BorderBrush" Value="#FFaaaaaa" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Grid Width="14" Height="14">
                    <Ellipse
                        x:Name="ellipse"
                        Fill="{TemplateBinding Background}"
                        Stroke="{TemplateBinding BorderBrush}" />
                    <Ellipse
                        x:Name="ellipseHighlight"
                        Fill="#FFBD7777"
                        Opacity="0"
                        Stroke="Red" />
                    <Path
                        x:Name="path"
                        Margin="4.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M0.5,0.5 L8.5,8.5 M8.5000095,0.50000072 L0.50000954,8.500001"
                        Stretch="Fill"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="1"
                        UseLayoutRounding="False" />
                    <Path
                        x:Name="pathHighlight"
                        Margin="4.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M0.5,0.5 L8.5,8.5 M8.5000095,0.50000072 L0.50000954,8.500001"
                        Opacity="0"
                        Stretch="Fill"
                        Stroke="Red"
                        StrokeThickness="1"
                        UseLayoutRounding="False" />
                    <ContentPresenter
                        x:Name="contentPresenter"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        IsVisible="False" />
                    <Rectangle
                        x:Name="DisabledVisualElement"
                        Fill="#FFFFFFFF"
                        IsHitTestVisible="false"
                        Opacity="0"
                        RadiusX="3"
                        RadiusY="3" />
                    <Rectangle
                        x:Name="FocusVisualElement"
                        Margin="1"
                        IsHitTestVisible="false"
                        Opacity="0"
                        RadiusX="2"
                        RadiusY="2"
                        Stroke="#FF6DBDD1"
                        StrokeThickness="1" />

                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Ellipse#ellipseHighlight">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#ellipseHighlight">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pressed /template/ Path#pathHighlight">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_FocusVisual">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!--  ClearableTextBox  -->

    <ControlTheme x:Key="{x:Type controls:ClearableTextBox}" TargetType="controls:ClearableTextBox">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#888" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1,0,0,0" />
        <Setter Property="DragDrop.AllowDrop" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
     
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ClearableTextBox">
                <Grid>
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="1" />
                    <ScrollViewer
                        x:Name="PART_ContentHost"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        UseLayoutRounding="{TemplateBinding UseLayoutRounding}" />
                    <TextPresenter
                        x:Name="PART_TextPresenter"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        CaretBrush="{TemplateBinding CaretBrush}"
                        CaretIndex="{TemplateBinding CaretIndex}"
                        PasswordChar="{TemplateBinding PasswordChar}"
                        RevealPassword="{TemplateBinding RevealPassword}"
                        SelectionBrush="{TemplateBinding SelectionBrush}"
                        SelectionEnd="{TemplateBinding SelectionEnd}"
                        SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                        SelectionStart="{TemplateBinding SelectionStart}"
                        Text="{TemplateBinding Text}"
                        TextAlignment="{TemplateBinding TextAlignment}"
                        TextWrapping="{TemplateBinding TextWrapping}" />

                    <Button
                        x:Name="TextRemover"
                        Width="14"
                        Height="14"
                        Margin="0,0,3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        IsTabStop="False"
                        RenderTransformOrigin="0.5,0.5"
                        Theme="{StaticResource ClearButtonStyle}">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Button.RenderTransform>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
        <!--  Pseudo Classes  -->
        <Style Selector="^.text-remover-visible /template/ Button#TextRemover">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter>
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^.text-remover-hidden /template/ Button#TextRemover">
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="0" ScaleY="0" />
            </Setter>
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

    <!--  SkewThumb  -->

    <ControlTheme x:Key="SkewThumbHorizontal" TargetType="Thumb">
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Canvas Width="14" Height="4" UseLayoutRounding="True">
                    <Path
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Data="M0,2 L3,0 L11,0 L14,2 L11,4 L3,4 Z"
                        Fill="#CC474747"
                        Stroke="White"
                        StrokeThickness="0.5" />
                </Canvas>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path">
            <Setter Property="Fill" Value="#FF2196F3" />
        </Style>
        <Style Selector="^:pressed /template/ Path">
            <Setter Property="Fill" Value="#FF0D47A1" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SkewThumbVertical" TargetType="Thumb">
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Canvas Width="4" Height="14" UseLayoutRounding="True">
                    <Path
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Data="M2,0 L4,3 L4,11 L2,14 L0,11 L0,3 Z"
                        Fill="#CC474747"
                        Stroke="White"
                        StrokeThickness="0.5" />
                </Canvas>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path">
            <Setter Property="Fill" Value="#FF2196F3" />
        </Style>
        <Style Selector="^:pressed /template/ Path">
            <Setter Property="Fill" Value="#FF0D47A1" />
        </Style>
    </ControlTheme>

    <!--  RenderTransformOriginThumb  -->

    <ControlTheme x:Key="{x:Type controls:RenderTransformOriginThumb}" TargetType="controls:RenderTransformOriginThumb">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:RenderTransformOriginThumb">
                <Grid
                    Width="10"
                    Height="10"
                    Margin="-5,-5,-5,-5">
                    <Ellipse
                        Width="2"
                        Height="2"
                        Fill="Black" />
                    <Ellipse
                        Width="10"
                        Height="10"
                        Fill="Transparent"
                        Stroke="Black"
                        StrokeThickness="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
