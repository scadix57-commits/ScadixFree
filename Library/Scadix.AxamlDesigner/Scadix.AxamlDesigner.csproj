<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Suppress nullable, CLS-compliance, and obsolete serialization warnings inherited from WPF migration -->
		<NoWarn>CS8605;CS8600;CS8601;CS8602;CS8603;CS8604;CS8612;CS8618;CS8621;CS8622;CS8625;CS8765;CS8767;CS3001;CS3002;CS3003;CS3009;SYSLIB0051</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.13" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.13" />
		<PackageReference Include="Avalonia.Labs.CommandManager" Version="11.3.1" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.13" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Scadix.AxamlDesign\Scadix.AxamlDesign.csproj" />
	  <ProjectReference Include="..\Scadix.AxamlDom\Scadix.AxamlDom.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Images\*" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="PropertyGrid\Editors\ImageTypeEditor.axaml.cs">
	    <DependentUpon>ImageTypeEditor.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
